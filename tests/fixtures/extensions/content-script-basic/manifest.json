{
  "manifest_version": 3,
  "name": "Vast Content Script Fixture",
  "version": "1.0.0",
  "description": "Deterministic unpacked extension fixture for Vast runtime tests.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
