# Vast public Windows beta/stable release environment.
# Copy this to .env.release.local, fill local values, then run:
#   npm run release:local
# Do not commit real signing secrets.

VAST_RELEASE_CHANNEL=stable
VAST_PRIVATE_BUILD=0
VAST_RELEASE_REPO=vstxx/vast-public
VAST_PREVIOUS_VERSION=0.1.4
VAST_UPDATE_ENABLED=1
VAST_OBFUSCATE=1
VAST_EXPECTED_SIGNER_SUBJECT=VastProductions

# Optional passive Vast Notices feed. Keep disabled until a dedicated HTTPS
# origin and Ed25519 public key are provisioned. It must not use GitHub's
# updater origins.
VAST_NOTICES_ENABLED=0
# VAST_NOTICES_FEED_URL=https://notices.example.com/vast/notices.json
# VAST_NOTICES_KEY_ID=vast-notices-2026-01
# VAST_NOTICES_PUBLIC_KEY_SPKI_BASE64=<base64-encoded-Ed25519-DER-SPKI-public-key>

# Windows code-signing inputs are required for every public beta/stable release.
# Use a publicly trusted Authenticode certificate, not a self-signed test cert.
# Prefer secure CI or local secret storage. Do not commit these values.
WIN_CSC_LINK=C:\secure\vast-code-signing.pfx
WIN_CSC_KEY_PASSWORD=<pfx-password>

# Exceptional public unsigned beta only. Do not combine this with stable or
# signing inputs. Prefer `npm run release:public-unsigned-beta`, which sets and
# validates these values while removing certificate variables from the child
# process.
# VAST_PUBLIC_UNSIGNED_BETA=1
# VAST_UNSIGNED_BETA_ACK=I_ACCEPT_UNSIGNED_PUBLIC_BETA_RISK

# Optional explicit paths used while generating the self-contained Video &
# Audio runtime. The release gate records and hashes the selected binaries.
# VAST_AVIDAE_FFMPEG=C:\Program Files\ffmpeg\bin\ffmpeg.exe
# VAST_AVIDAE_FFPROBE=C:\Program Files\ffmpeg\bin\ffprobe.exe

# Required only when the workflow publishes to and re-downloads from the
# separate production release repository.
# VAST_RELEASE_TOKEN=<fine-grained token; never commit>
