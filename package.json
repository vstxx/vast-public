{
  "name": "vast-browser",
  "productName": "Vast",
  "version": "0.2.7",
  "description": "Vast - a local-first, power-user desktop browser shell built with Electron, React, TypeScript, Vite, and TailwindCSS.",
  "author": "VastProductions",
  "main": "out/main/main.js",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vstxx/vast-public.git"
  },
  "homepage": "https://github.com/vstxx/vast-public#readme",
  "bugs": {
    "url": "https://github.com/vstxx/vast-public/issues"
  },
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "node scripts/build-app.cjs",
    "avidae:runtime:prepare": "node scripts/prepare-avidae-runtime.cjs",
    "avidae:runtime:check": "node scripts/prepare-avidae-runtime.cjs --check",
    "avidae:ffmpeg:check": "node scripts/avidae-ffmpeg-capabilities.cjs",
    "ffmpeg:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-vast-ffmpeg.ps1",
    "ffmpeg:release:check": "node scripts/check-ffmpeg-release-compliance.cjs",
    "build:obfuscated": "npm run build && node scripts/obfuscate-build.cjs && npm run performance:budget",
    "preview": "electron-vite preview",
    "dist": "npm run build:obfuscated && electron-builder",
    "dist:direct": "node scripts/build-release.cjs upgrader",
    "dist:store": "node scripts/build-store-msix.cjs",
    "dist:store:dev": "node scripts/build-store-msix.cjs --development",
    "dist:upgrader": "node scripts/build-release.cjs upgrader",
    "lint": "tsc --noEmit",
    "test": "node scripts/run-node-tests.cjs",
    "test:unit": "node scripts/run-node-tests.cjs",
    "test:updater": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/updater/vast-updater.test.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File tests/updater/vast-bootstrapper-release.test.ps1",
    "test:upgrade:public": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/updater/vast-public-beta-upgrade.test.ps1",
    "test:upgrade:0.1.5": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/updater/vast-0.1.5-to-0.2.5-upgrade.test.ps1",
    "test:fuses:integration": "node scripts/test-electron-fuses-integration.cjs",
    "test:electron-version": "node scripts/verify-electron-version.cjs",
    "test:store": "node --test tests/store/*.test.cjs",
    "test:store:upgrade": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/store/store-msix-upgrade.test.ps1",
    "store:policy:refresh": "node scripts/check-store-browser-recency.cjs --refresh",
    "test:package:ci": "node scripts/verify-ci-package.cjs",
    "updater:stage": "node scripts/stage-updater-sources.cjs",
    "test:app": "node scripts/run-app-test.cjs",
    "test:extensions:e2e": "node scripts/run-isolated-electron-e2e.cjs extensions-e2e.cjs",
    "test:extensions:native-e2e": "node scripts/run-isolated-electron-e2e.cjs native-extensions-e2e.cjs",
    "extension:pack": "node scripts/pack-extension.cjs",
    "hub:types": "wrangler types extensions-hub/worker-configuration.d.ts --config extensions-hub/wrangler.jsonc",
    "hub:typecheck": "tsc --noEmit -p extensions-hub/tsconfig.json",
    "hub:test": "vitest run --config extensions-hub/vitest.config.ts",
    "hub:build": "wrangler deploy --dry-run --config extensions-hub/wrangler.jsonc --env= --outdir dist",
    "hub:verify:production": "node scripts/verify-hub-production-readiness.mjs",
    "test:split-view": "node scripts/run-app-test.cjs --split-view-only",
    "test:google-auth-email": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/google-auth-email-ui-check.ps1",
    "test:google-auth-email:cdp": "node scripts/google-auth-email-check.cjs",
    "performance:baseline": "node scripts/performance-suite.cjs --phase=baseline",
    "performance:final": "node scripts/performance-suite.cjs --phase=final",
    "performance:budget": "node scripts/check-performance-budget.cjs",
    "performance:webcontents-view-spike": "node scripts/webcontents-view-spike.cjs",
    "performance:compare": "node scripts/performance-compare.cjs",
    "distribution:size-audit": "node scripts/distribution-size-audit.cjs",
    "distribution:size-budget": "npm run distribution:size-audit && node scripts/check-distribution-size-budget.cjs",
    "audit:ci": "npm audit --audit-level=high && npm audit --prefix relay --audit-level=high",
    "ci": "npm run audit:ci && npm run lint && npm run test && npm run release:audit",
    "release:check": "node scripts/release-check.cjs",
    "release:direct:check": "node scripts/release-check.cjs",
    "release:store:check": "node scripts/release-store-check.cjs",
    "release:0.2.7": "npm run release:version-check && npm run test:electron-version && npm run test:store",
    "store:wack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-windows-app-certification.ps1",
    "release:audit": "node scripts/release-audit.cjs",
    "release:local": "node scripts/local-release-from-env.cjs",
    "release:internal": "node scripts/local-release-from-env.cjs --internal-unsigned",
    "release:public-unsigned": "node scripts/local-release-from-env.cjs --public-unsigned-release",
    "release:check:local": "node scripts/local-release-from-env.cjs release:check",
    "release:verify:published": "node scripts/verify-published-release.cjs",
    "dist:private": "npm run release:audit && npm run dist",
    "dist:public": "npm run dist:upgrader",
    "release:stable": "npm run dist:upgrader",
    "release:windows": "npm run dist:upgrader",
    "release:version-check": "node scripts/release-version-consistency.cjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "fflate": "0.8.3",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.0.0",
    "@electron/fuses": "2.1.2",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "5.2.0",
    "7zip-bin": "5.2.0",
    "acorn": "8.18.0",
    "autoprefixer": "10.5.0",
    "clsx": "2.1.1",
    "electron": "44.1.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "javascript-obfuscator": "^5.4.3",
    "lucide-react": "1.16.0",
    "pdfjs-dist": "6.2.108",
    "postcss": "8.5.25",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "3.4.19",
    "tldts": "7.4.11",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "wrangler": "4.125.0",
    "zustand": "5.0.13"
  },
  "overrides": {
    "tmp": "0.2.7",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.6",
    "@xmldom/xmldom": "0.8.15",
    "@electron/get": {
      "undici": "7.29.0"
    }
  },
  "build": {
    "appId": "app.vast.browser",
    "productName": "Vast",
    "icon": "assets/logos/vasticon.png",
    "asar": true,
    "forceCodeSigning": true,
    "afterPack": "scripts/after-pack-hardening.cjs",
    "afterSign": "scripts/after-sign-all-pe.cjs",
    "directories": {
      "output": "release"
    },
    "toolsets": {
      "winCodeSign": "1.0.0"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/avidae",
        "to": "avidae"
      },
      {
        "from": "resources/avidae-runtime",
        "to": "avidae-runtime"
      },
      {
        "from": "assets/logos/vasticon.png",
        "to": "app-icon.png"
      },
      {
        "from": "assets/logos/vasticon-windows.png",
        "to": "app-icon-windows.png"
      },
      {
        "from": "assets/logos/vast.png",
        "to": "app-wordmark.png"
      },
      {
        "from": "node_modules/tldts/dist/index.cjs.min.js",
        "to": "runtime/tldts.cjs"
      },
      {
        "from": "node_modules/tldts/LICENSE",
        "to": "licenses/tldts-LICENSE"
      }
    ],
    "protocols": [
      {
        "name": "Vast Browser",
        "schemes": [
          "vast"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/logos/vasticon-windows.png",
      "signAndEditExecutable": true,
      "signExecutable": true,
      "signtoolOptions": {
        "publisherName": [
          "VastProductions"
        ]
      }
    },
    "nsis": {
      "artifactName": "Vast-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "Vast-${version}-Portable.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/logos/vasticon.png",
      "hardenedRuntime": true,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.inherit.plist"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/logos/vasticon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "vstxx",
      "repo": "vast-public",
      "releaseType": "release"
    }
  }
}
