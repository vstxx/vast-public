diff --git a/shell/browser/api/electron_api_extensions.cc b/shell/browser/api/electron_api_extensions.cc
--- a/shell/browser/api/electron_api_extensions.cc
+++ b/shell/browser/api/electron_api_extensions.cc
@@ -99,6 +99,16 @@ void Extensions::RemoveExtension(const std::string& extension_id) {
   extension_system->RemoveExtension(extension_id);
 }
 
+void Extensions::ReloadExtension(const std::string& extension_id) {
+  auto* registry = extensions::ExtensionRegistry::Get(browser_context());
+  if (!registry->GetInstalledExtension(extension_id))
+    return;
+
+  auto* extension_system = static_cast<extensions::ElectronExtensionSystem*>(
+      extensions::ExtensionSystem::Get(browser_context()));
+  extension_system->ReloadExtension(extension_id);
+}
+
 v8::Local<v8::Value> Extensions::GetExtension(v8::Isolate* isolate,
                                               const std::string& extension_id) {
   auto* registry = extensions::ExtensionRegistry::Get(browser_context());
@@ -153,6 +163,7 @@ gin::ObjectTemplateBuilder Extensions::GetObjectTemplateBuilder(
              isolate)
       .SetMethod("loadExtension", &Extensions::LoadExtension)
       .SetMethod("removeExtension", &Extensions::RemoveExtension)
+      .SetMethod("reloadExtension", &Extensions::ReloadExtension)
       .SetMethod("getExtension", &Extensions::GetExtension)
       .SetMethod("getAllExtensions", &Extensions::GetAllExtensions);
 }
diff --git a/shell/browser/api/electron_api_extensions.h b/shell/browser/api/electron_api_extensions.h
--- a/shell/browser/api/electron_api_extensions.h
+++ b/shell/browser/api/electron_api_extensions.h
@@ -41,6 +41,7 @@ class Extensions final : public gin::Wrappable<Extensions>,
                                        const base::FilePath& extension_path,
                                        gin::Arguments* args);
   void RemoveExtension(const std::string& extension_id);
+  void ReloadExtension(const std::string& extension_id);
   v8::Local<v8::Value> GetExtension(v8::Isolate* isolate,
                                     const std::string& extension_id);
   v8::Local<v8::Value> GetAllExtensions(v8::Isolate* isolate);
