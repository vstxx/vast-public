+void ElectronExtensionLoader::DispatchLifecycleEvent(
+    const ExtensionId& extension_id,
+    bool installed_or_updated,
+    const base::Version& previous_version) {
+  if (!ExtensionRegistry::Get(browser_context_)
+           ->enabled_extensions()
+           .Contains(extension_id)) {
+    return;
+  }
+  if (installed_or_updated) {
+    RuntimeEventRouter::DispatchOnInstalledEvent(
+        static_cast<void*>(browser_context_),
+        extension_id, previous_version, /*chrome_updated=*/false);
+  } else {
+    RuntimeEventRouter::DispatchOnStartupEvent(browser_context_, extension_id);
+  }
