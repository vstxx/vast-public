+#include "shell/browser/api/electron_api_session.h"
+#include "shell/browser/api/electron_api_web_contents.h"
+#include "shell/browser/javascript_environment.h"
 
 using content::WebContents;
 
 namespace extensions {
 
+namespace {
+
+void NotifyActionOpenPopup(ExtensionFunction* function) {
+  auto* session_cell =
+      electron::api::Session::FromBrowserContext(function->browser_context());
+  auto* sender_contents = function->GetSenderWebContents();
+  auto* sender = electron::api::WebContents::From(sender_contents);
+  if (!session_cell || !session_cell->Get() || !sender ||
+      !function->extension()) {
+    return;
+  }
+
+  v8::Isolate* isolate = electron::JavascriptEnvironment::GetIsolate();
+  v8::HandleScope handle_scope(isolate);
+  session_cell->Get()->Extensions(isolate)->NotifyActionOpenPopup(
+      function->extension()->id(), sender->ID());
+}
+
+}  // namespace
