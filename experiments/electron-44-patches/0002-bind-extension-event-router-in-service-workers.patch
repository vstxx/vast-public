--- a/shell/browser/electron_browser_client.cc
+++ b/shell/browser/electron_browser_client.cc
@@ -1672,6 +1672,12 @@ void ElectronBrowserClient::RegisterAssociatedInterfaceBindersForServiceWorker(
                           service_worker_version_info.version_id));
 
 #if BUILDFLAG(ENABLE_ELECTRON_EXTENSIONS)
+  // Extension service workers register persistent event listeners through this
+  // interface. Without the binder, events such as alarms.onAlarm never reach
+  // the worker even though addListener() succeeds in JavaScript.
+  associated_registry.AddInterface<extensions::mojom::EventRouter>(
+      base::BindRepeating(&extensions::EventRouter::BindForRenderer,
