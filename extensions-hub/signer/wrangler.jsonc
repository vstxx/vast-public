{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vast-extensions-hub-signer",
  "main": "../src/signer.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "SIGNING_KEY_ID": "vast-hub-2026-02", "HUB_ORIGIN": "https://extensions.vastbrowser.com" },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false, "head_sampling_rate": 0.05 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "env": {
    "staging": {
      "name": "vast-extensions-hub-signer-staging",
      "workers_dev": false,
      "preview_urls": false,
      "vars": { "SIGNING_KEY_ID": "vast-hub-staging-2026-02", "HUB_ORIGIN": "https://extensions-staging.vastbrowser.com" },
      "observability": {
        "enabled": true,
        "logs": { "invocation_logs": false, "head_sampling_rate": 0.2 },
        "traces": { "enabled": true, "head_sampling_rate": 0.05 }
      }
    }
  }
}
