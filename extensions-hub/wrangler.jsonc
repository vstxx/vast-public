{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "vast-extensions-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "extensions.vastbrowser.com", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vast-extensions-hub",
      "database_id": "dc35981e-2b78-4884-bf70-2620f4472251",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "PACKAGES", "bucket_name": "vast-extensions-packages" }],
  "images": { "binding": "IMAGES" },
  "services": [{ "binding": "HUB_SIGNER", "service": "vast-extensions-hub-signer" }],
  "ratelimits": [
    { "name": "HUB_PUBLIC_RATE_LIMIT", "namespace_id": "870001", "simple": { "limit": 180, "period": 60 } },
    { "name": "HUB_AUTH_RATE_LIMIT", "namespace_id": "870002", "simple": { "limit": 20, "period": 60 } },
    { "name": "HUB_PUBLISH_RATE_LIMIT", "namespace_id": "870003", "simple": { "limit": 120, "period": 60 } },
    { "name": "HUB_REVIEW_RATE_LIMIT", "namespace_id": "870004", "simple": { "limit": 60, "period": 60 } },
    { "name": "HUB_REPORT_RATE_LIMIT", "namespace_id": "870005", "simple": { "limit": 5, "period": 60 } }
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/explore*", "/extension/*", "/dashboard*", "/review*", "/report*", "/legal/*", "/auth/*", "/v1/*", "/packages/*", "/media/*"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "HUB_ORIGIN": "https://extensions.vastbrowser.com",
    "GITHUB_REDIRECT_URI": "https://extensions.vastbrowser.com/auth/github/callback",
    "SIGNING_KEY_ID": "vast-hub-2026-02",
    "HUB_LEGAL_OPERATOR_NAME": "Jan Nowacki",
    "HUB_LEGAL_CONTACT_URL": "https://vastbrowser.com/legal"
  },
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false, "head_sampling_rate": 0.05 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "env": {
    "staging": {
      "name": "vast-extensions-hub-staging",
      "routes": [{ "pattern": "extensions-staging.vastbrowser.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vast-extensions-hub-staging",
          "database_id": "23f8714d-7c27-4756-b3b7-9f884cd76b4d",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "PACKAGES", "bucket_name": "vast-extensions-packages-staging" }],
      "images": { "binding": "IMAGES" },
      "services": [{ "binding": "HUB_SIGNER", "service": "vast-extensions-hub-signer-staging" }],
      "ratelimits": [
        { "name": "HUB_PUBLIC_RATE_LIMIT", "namespace_id": "871001", "simple": { "limit": 180, "period": 60 } },
        { "name": "HUB_AUTH_RATE_LIMIT", "namespace_id": "871002", "simple": { "limit": 20, "period": 60 } },
        { "name": "HUB_PUBLISH_RATE_LIMIT", "namespace_id": "871003", "simple": { "limit": 120, "period": 60 } },
        { "name": "HUB_REVIEW_RATE_LIMIT", "namespace_id": "871004", "simple": { "limit": 60, "period": 60 } },
        { "name": "HUB_REPORT_RATE_LIMIT", "namespace_id": "871005", "simple": { "limit": 5, "period": 60 } }
      ],
      "assets": {
        "directory": "public",
        "binding": "ASSETS",
        "run_worker_first": ["/", "/explore*", "/extension/*", "/dashboard*", "/review*", "/report*", "/legal/*", "/auth/*", "/v1/*", "/packages/*", "/media/*"]
      },
      "triggers": { "crons": [] },
      "vars": {
        "ENVIRONMENT": "staging",
        "HUB_ORIGIN": "https://extensions-staging.vastbrowser.com",
        "GITHUB_REDIRECT_URI": "https://extensions-staging.vastbrowser.com/auth/github/callback",
        "SIGNING_KEY_ID": "vast-hub-staging-2026-02",
        "HUB_LEGAL_OPERATOR_NAME": "Jan Nowacki",
        "HUB_LEGAL_CONTACT_URL": "https://vastbrowser.com/legal"
      },
      "observability": {
        "enabled": true,
        "logs": { "invocation_logs": false, "head_sampling_rate": 0.2 },
        "traces": { "enabled": true, "head_sampling_rate": 0.05 }
      }
    }
  }
}
