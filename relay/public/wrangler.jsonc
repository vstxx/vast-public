{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "vast-relay-public-local",
  "main": "../src/public/index.ts",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ENVIRONMENT": "local"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vast-relay-local",
      "migrations_dir": "../migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "vast-relay-assets-local"
    }
  ],
  "ratelimits": [
    {
      "name": "CHECKIN_SOURCE_RATE_LIMIT",
      "namespace_id": "861001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "CHECKIN_INSTALL_RATE_LIMIT",
      "namespace_id": "861002",
      "simple": {
        "limit": 12,
        "period": 60
      }
    },
    {
      "name": "ASSET_SOURCE_RATE_LIMIT",
      "namespace_id": "861003",
      "simple": {
        "limit": 180,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "env": {
    "staging": {
      "name": "vast-relay-public-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "relay-staging.vastbrowser.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "ENVIRONMENT": "staging"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vast-relay-staging",
          "migrations_dir": "../migrations",
          "database_id": "786cd3fa-013f-43fe-bdc4-1ac610e98c87"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS",
          "bucket_name": "vast-relay-assets-staging"
        }
      ],
      "ratelimits": [
        {
          "name": "CHECKIN_SOURCE_RATE_LIMIT",
          "namespace_id": "862001",
          "simple": {
            "limit": 60,
            "period": 60
          }
        },
        {
          "name": "CHECKIN_INSTALL_RATE_LIMIT",
          "namespace_id": "862002",
          "simple": {
            "limit": 12,
            "period": 60
          }
        },
        {
          "name": "ASSET_SOURCE_RATE_LIMIT",
          "namespace_id": "862003",
          "simple": {
            "limit": 180,
            "period": 60
          }
        }
      ]
    },
    "production": {
      "name": "vast-relay-public-production",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "relay.vastbrowser.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "ENVIRONMENT": "production"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vast-relay-production",
          "migrations_dir": "../migrations",
          "database_id": "462a6d89-872e-4b7b-837e-9828f2338983"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS",
          "bucket_name": "vast-relay-assets-production"
        }
      ],
      "ratelimits": [
        {
          "name": "CHECKIN_SOURCE_RATE_LIMIT",
          "namespace_id": "863001",
          "simple": {
            "limit": 60,
            "period": 60
          }
        },
        {
          "name": "CHECKIN_INSTALL_RATE_LIMIT",
          "namespace_id": "863002",
          "simple": {
            "limit": 12,
            "period": 60
          }
        },
        {
          "name": "ASSET_SOURCE_RATE_LIMIT",
          "namespace_id": "863003",
          "simple": {
            "limit": 180,
            "period": 60
          }
        }
      ]
    }
  }
}
