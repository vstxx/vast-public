+
+#ifndef CHROME_BROWSER_UI_WEBUI_VAST_VAST_UI_H_
+#define CHROME_BROWSER_UI_WEBUI_VAST_VAST_UI_H_
+
+#include "chrome/common/webui_url_constants.h"
+#include "content/public/browser/web_ui_controller.h"
+#include "content/public/browser/webui_config.h"
+#include "content/public/common/url_constants.h"
+
+namespace vast {
+
+class VastUI;
+
+class VastUIConfig : public content::DefaultWebUIConfig<VastUI> {
+ public:
+  VastUIConfig()
+      : DefaultWebUIConfig(content::kChromeUIScheme,
+                           chrome::kChromeUIVastHost) {}
+};
+
+// Profile-scoped controller for chrome://vast.
+class VastUI : public content::WebUIController {
+ public:
+  explicit VastUI(content::WebUI* web_ui);
+  ~VastUI() override;
+
+  VastUI(const VastUI&) = delete;
+  VastUI& operator=(const VastUI&) = delete;
+};
+
+}  // namespace vast
+
+#endif  // CHROME_BROWSER_UI_WEBUI_VAST_VAST_UI_H_
