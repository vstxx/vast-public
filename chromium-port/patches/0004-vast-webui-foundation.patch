diff --git a/chrome/browser/resources/vast/BUILD.gn b/chrome/browser/resources/vast/BUILD.gn
new file mode 100644
index 0000000000000000000000000000000000000000..b277f7ff00b460f39257e64c0bb70b78fd730f4f
--- /dev/null
+++ b/chrome/browser/resources/vast/BUILD.gn
@@ -0,0 +1,19 @@
+# Copyright 2026 The Vast Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+import("//ui/webui/resources/tools/build_webui.gni")
+
+build_webui("build") {
+  grd_prefix = "vast"
+
+  static_files = [
+    "app.css",
+    "index.html",
+    "vast-logo.png",
+  ]
+
+  ts_files = [ "app.ts" ]
+
+  ts_deps = [ "//ui/webui/resources/js:build_ts" ]
+}
diff --git a/chrome/browser/resources/vast/app.css b/chrome/browser/resources/vast/app.css
new file mode 100644
index 0000000000000000000000000000000000000000..0056dd423daf138faaed191e04985578436b9104
--- /dev/null
+++ b/chrome/browser/resources/vast/app.css
@@ -0,0 +1,226 @@
+:root {
+  --vast-accent: #74e7ff;
+  --vast-accent-secondary: #b86cff;
+  --vast-bg: #050507;
+  --vast-text: #f3f5f8;
+  --vast-muted: #9aa0ad;
+  --vast-border: rgba(255, 255, 255, 0.1);
+  color-scheme: dark;
+  font-family: Inter, ui-sans-serif, system-ui, -apple-system,
+    BlinkMacSystemFont, 'Segoe UI', sans-serif;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+html,
+body {
+  min-height: 100%;
+}
+
+body {
+  margin: 0;
+  color: var(--vast-text);
+  background:
+    radial-gradient(circle at 16% 0%, rgba(116, 231, 255, 0.11),
+      transparent 34rem),
+    radial-gradient(circle at 88% 18%, rgba(184, 108, 255, 0.12),
+      transparent 32rem),
+    linear-gradient(150deg, #050507 0%, #090b11 55%, #050507 100%);
+}
+
+.shell {
+  width: min(1180px, calc(100% - 56px));
+  margin: 0 auto;
+  padding: 24px 0 32px;
+}
+
+.topbar,
+.brand,
+.actions,
+footer,
+.status-line {
+  display: flex;
+  align-items: center;
+}
+
+.topbar {
+  justify-content: space-between;
+}
+
+.brand {
+  gap: 12px;
+  font-size: 18px;
+  font-weight: 760;
+  letter-spacing: -0.02em;
+}
+
+.brand-mark {
+  width: 30px;
+  height: 30px;
+  object-fit: contain;
+}
+
+.phase {
+  padding: 8px 12px;
+  border: 1px solid var(--vast-border);
+  border-radius: 999px;
+  color: var(--vast-muted);
+  background: rgba(255, 255, 255, 0.035);
+  font-size: 12px;
+}
+
+.hero {
+  max-width: 900px;
+  padding: 112px 0 72px;
+}
+
+.eyebrow {
+  color: var(--vast-accent);
+  font-size: 12px;
+  font-weight: 760;
+  letter-spacing: 0.18em;
+}
+
+h1 {
+  margin: 14px 0 24px;
+  font-size: clamp(48px, 7.4vw, 92px);
+  line-height: 0.96;
+  letter-spacing: -0.065em;
+}
+
+h1 span {
+  color: #8d939f;
+}
+
+.intro {
+  max-width: 740px;
+  color: #b3b8c2;
+  font-size: 18px;
+  line-height: 1.65;
+}
+
+.actions {
+  gap: 12px;
+  margin-top: 32px;
+}
+
+.actions a {
+  padding: 12px 17px;
+  border-radius: 13px;
+  color: var(--vast-text);
+  font-weight: 700;
+  text-decoration: none;
+}
+
+.primary {
+  border: 1px solid rgba(116, 231, 255, 0.35);
+  background: linear-gradient(120deg, rgba(116, 231, 255, 0.23),
+    rgba(184, 108, 255, 0.26));
+}
+
+.secondary {
+  border: 1px solid var(--vast-border);
+  background: rgba(255, 255, 255, 0.045);
+}
+
+.actions a:focus-visible {
+  outline: 2px solid var(--vast-accent);
+  outline-offset: 3px;
+}
+
+.status-grid {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 14px;
+}
+
+.status-card {
+  min-height: 228px;
+  padding: 22px;
+  border: 1px solid var(--vast-border);
+  border-radius: 24px;
+  background: linear-gradient(145deg, rgba(255, 255, 255, 0.065),
+    rgba(255, 255, 255, 0.025));
+  box-shadow: 0 24px 72px rgba(0, 0, 0, 0.24);
+}
+
+.status-line {
+  gap: 9px;
+  margin-bottom: 48px;
+  color: var(--vast-muted);
+  font-size: 12px;
+  font-weight: 700;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+
+.status-dot {
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+}
+
+.status-dot.ready {
+  background: #6df0b3;
+  box-shadow: 0 0 18px rgba(109, 240, 179, 0.55);
+}
+
+.status-dot.active {
+  background: var(--vast-accent-secondary);
+  box-shadow: 0 0 18px rgba(184, 108, 255, 0.65);
+}
+
+.status-card strong {
+  display: block;
+  margin-bottom: 12px;
+  font-size: 20px;
+  letter-spacing: -0.025em;
+}
+
+.status-card p {
+  margin: 0;
+  color: var(--vast-muted);
+  line-height: 1.55;
+}
+
+footer {
+  gap: 10px;
+  padding-top: 28px;
+  color: #777d88;
+  font-size: 12px;
+}
+
+.divider {
+  width: 3px;
+  height: 3px;
+  border-radius: 50%;
+  background: #4c515b;
+}
+
+@media (max-width: 820px) {
+  .shell {
+    width: min(100% - 32px, 680px);
+  }
+
+  .hero {
+    padding-top: 80px;
+  }
+
+  .status-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .status-card {
+    min-height: 190px;
+  }
+
+  .status-line {
+    margin-bottom: 34px;
+  }
+
+  footer {
+    flex-wrap: wrap;
+  }
+}
diff --git a/chrome/browser/resources/vast/app.ts b/chrome/browser/resources/vast/app.ts
new file mode 100644
index 0000000000000000000000000000000000000000..784292d498a1bffe847bb3a9dffdd21abc6dc11d
--- /dev/null
+++ b/chrome/browser/resources/vast/app.ts
@@ -0,0 +1,28 @@
+// Copyright 2026 The Vast Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {loadTimeData} from '//resources/js/load_time_data.js';
+
+function setText(id: string, value: string) {
+  const element = document.querySelector<HTMLElement>(`#${id}`);
+  if (!element) {
+    throw new Error(`Missing Vast WebUI element: ${id}`);
+  }
+  element.textContent = value;
+}
+
+setText('runtime-architecture', loadTimeData.getString('runtimeArchitecture'));
+setText(
+    'product-version',
+    `${loadTimeData.getString('productName')} ${loadTimeData.getString('productVersion')}`);
+setText(
+    'chromium-version',
+    `Chromium ${loadTimeData.getString('chromiumVersion')}`);
+setText(
+    'runtime-proof',
+    loadTimeData.getBoolean('electronRuntimeAbsent') ?
+        'Electron runtime absent' :
+        'Runtime audit required');
+
+document.documentElement.dataset['vastReady'] = 'true';
diff --git a/chrome/browser/resources/vast/index.html b/chrome/browser/resources/vast/index.html
new file mode 100644
index 0000000000000000000000000000000000000000..565870ce7deb80f7807c129f7f4405c0b105a57b
--- /dev/null
+++ b/chrome/browser/resources/vast/index.html
@@ -0,0 +1,59 @@
+<!doctype html>
+<html lang="en" dir="ltr">
+<head>
+  <meta charset="utf-8">
+  <meta name="color-scheme" content="dark">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Vast</title>
+  <link rel="stylesheet" href="app.css">
+</head>
+<body>
+  <main class="shell">
+    <header class="topbar">
+      <div class="brand">
+        <img src="vast-logo.png" alt="" class="brand-mark">
+        <span>Vast</span>
+      </div>
+      <span class="phase">2.0 native preview</span>
+    </header>
+
+    <section class="hero">
+      <p class="eyebrow">CHROMIUM PORT</p>
+      <h1>A real browser core.<br><span>The Vast layer is next.</span></h1>
+      <p class="intro">This page is bundled into Chromium and served by a profile-scoped native WebUI controller. There is no Electron, Node.js renderer, embedded browser, or localhost UI server in this runtime.</p>
+      <nav class="actions" aria-label="Native browser destinations">
+        <a class="primary" href="chrome://version/">Runtime details</a>
+        <a class="secondary" href="chrome://settings/">Chromium settings</a>
+      </nav>
+    </section>
+
+    <section class="status-grid" aria-label="Migration status">
+      <article class="status-card" data-testid="runtime-card">
+        <div class="status-line"><span class="status-dot ready"></span><span>Native runtime</span></div>
+        <strong id="runtime-architecture"></strong>
+        <p>Normal tabs, sandbox, site isolation, cookies, service workers, downloads, popups, permissions, and DevTools.</p>
+      </article>
+      <article class="status-card">
+        <div class="status-line"><span class="status-dot ready"></span><span>Website authentication</span></div>
+        <strong>Top-level Google sign-in</strong>
+        <p>Website sessions run in ordinary Chromium tabs. Chrome Sync and private Google browser APIs remain out of scope.</p>
+      </article>
+      <article class="status-card">
+        <div class="status-line"><span class="status-dot active"></span><span>Vast product layer</span></div>
+        <strong>UI and services in migration</strong>
+        <p>Workspaces, settings, notes, backups, and the vault will move behind typed, profile-scoped native adapters.</p>
+      </article>
+    </section>
+
+    <footer>
+      <span id="product-version"></span>
+      <span class="divider"></span>
+      <span id="chromium-version"></span>
+      <span class="divider"></span>
+      <span id="runtime-proof"></span>
+    </footer>
+  </main>
+  <script type="module" src="strings.m.js"></script>
+  <script type="module" src="app.js"></script>
+</body>
+</html>
