+// Copyright 2026 The Vast Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/vast/vast_ui.h"
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/grit/vast_resources.h"
+#include "chrome/grit/vast_resources_map.h"
+#include "components/version_info/version_info.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "ui/webui/webui_util.h"
+
+namespace vast {
+
+VastUI::VastUI(content::WebUI* web_ui) : content::WebUIController(web_ui) {
+  Profile* profile = Profile::FromWebUI(web_ui);
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      profile, chrome::kChromeUIVastHost);
+  source->AddString("productName", "Vast");
+  source->AddString("productVersion", "2.0.0-dev");
+  source->AddString("chromiumVersion", version_info::GetVersionNumber());
+  source->AddString("runtimeArchitecture", "Upstream Chromium //chrome");
+  source->AddBoolean("electronRuntimeAbsent", true);
+  webui::SetupWebUIDataSource(source, kVastResources, IDR_VAST_INDEX_HTML);
+}
+
+VastUI::~VastUI() = default;
+
+}  // namespace vast
