+  VastWorkspaceGroupRegistryResult removed;
+  restarted_service.UpdateWorkspaceGroupRegistration(
+      "workspace", first_token, false,
+      base::BindOnce(
+          [](VastWorkspaceGroupRegistryResult* output, base::OnceClosure quit,
+             VastWorkspaceGroupRegistryResult result) {
+            *output = std::move(result);
+            std::move(quit).Run();
+          },
+          &removed, remove_loop.QuitClosure()));
+  remove_loop.Run();
+  ASSERT_TRUE(removed.success) << removed.error;
+  ASSERT_EQ(removed.registry.registrations.size(), 1u);
+  EXPECT_EQ(removed.registry.registrations[0].group_token, second_token);
+}
