+void VastProductDataService::OnStatusReadyForWorkspaceGroupRegistry(
+    WorkspaceGroupRegistryCallback callback,
+    VastProductDataRootStatus status) {
+  if (!status.selected || !status.compatible || !status.projection.compatible ||
+      status.transaction.journal_path.empty()) {
+    VastWorkspaceGroupRegistryResult result;
+    result.error = status.error.empty()
+                       ? "No compatible Vast product data is selected."
+                       : status.error;
+    std::move(callback).Run(std::move(result));
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&LoadWorkspaceGroupRegistryOnWorker, profile_path_,
+                     status.transaction.journal_path, WorkspaceIds(status)),
+      std::move(callback));
+}
+
+void VastProductDataService::StartNextWorkspaceGroupUpdate() {
+  if (workspace_group_update_in_progress_ ||
+      pending_workspace_group_updates_.empty() || shutdown_) {
+    return;
+  }
+  workspace_group_update_in_progress_ = true;
+  GetStatus(base::BindOnce(
+      &VastProductDataService::OnStatusReadyForWorkspaceGroupUpdate,
+      weak_ptr_factory_.GetWeakPtr()));
+}
+
+void VastProductDataService::OnStatusReadyForWorkspaceGroupUpdate(
+    VastProductDataRootStatus status) {
+  if (pending_workspace_group_updates_.empty()) {
+    workspace_group_update_in_progress_ = false;
+    return;
+  }
+  const PendingWorkspaceGroupUpdate& update =
+      pending_workspace_group_updates_.front();
+  const bool known_workspace =
+      std::ranges::any_of(status.projection.workspaces,
+                          [&](const VastWorkspaceProjection& workspace) {
+                            return workspace.id == update.workspace_id;
+                          });
+  if (!status.selected || !status.compatible || !status.projection.compatible ||
+      status.transaction.journal_path.empty() || !known_workspace) {
+    VastWorkspaceGroupRegistryResult result;
+    result.error = !known_workspace
+                       ? "The requested Vast workspace does not exist."
+                       : (status.error.empty()
+                              ? "No compatible Vast product data is selected."
+                              : status.error);
+    OnWorkspaceGroupUpdateComplete(std::move(result));
+    return;
+  }
+
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&UpdateWorkspaceGroupRegistryOnWorker, profile_path_,
+                     status.transaction.journal_path, WorkspaceIds(status),
+                     update.workspace_id, update.group_token, update.present),
+      base::BindOnce(&VastProductDataService::OnWorkspaceGroupUpdateComplete,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void VastProductDataService::OnWorkspaceGroupUpdateComplete(
+    VastWorkspaceGroupRegistryResult result) {
+  if (pending_workspace_group_updates_.empty()) {
+    workspace_group_update_in_progress_ = false;
+    return;
+  }
+  WorkspaceGroupRegistryCallback callback =
+      std::move(pending_workspace_group_updates_.front().callback);
+  pending_workspace_group_updates_.pop_front();
+  workspace_group_update_in_progress_ = false;
+  std::move(callback).Run(std::move(result));
+  StartNextWorkspaceGroupUpdate();
+}
+
 }  // namespace vast
