@@ -0,0 +1,54 @@
+// Copyright 2026 The Vast Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_VAST_VAST_WORKSPACE_GROUP_REGISTRY_H_
+#define CHROME_BROWSER_VAST_VAST_WORKSPACE_GROUP_REGISTRY_H_
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+
+namespace vast {
+
+struct VastWorkspaceGroupRegistration {
+  std::string workspace_id;
+  std::string group_token;
+
+  friend bool operator==(const VastWorkspaceGroupRegistration&,
+                         const VastWorkspaceGroupRegistration&) = default;
+};
+
+struct VastWorkspaceGroupRegistry {
+  std::vector<VastWorkspaceGroupRegistration> registrations;
+  bool stale = false;
+};
+
+// Loads only URL-free native group identity for the exact recovered migration
+// journal. Absence or a registry from a replaced migration is a successful
+// empty result. Malformed, unsafe, duplicate, or unknown entries fail closed.
+bool LoadVastWorkspaceGroupRegistry(
+    const base::FilePath& profile_path,
+    const base::FilePath& journal_path,
+    base::span<const std::string> known_workspace_ids,
+    VastWorkspaceGroupRegistry* registry,
+    std::string* error);
+
+// Performs one bounded read-modify-write update using atomic replacement. The
+// caller must serialize concurrent updates for a profile.
+bool UpdateVastWorkspaceGroupRegistration(
+    const base::FilePath& profile_path,
+    const base::FilePath& journal_path,
+    base::span<const std::string> known_workspace_ids,
+    std::string_view workspace_id,
+    std::string_view group_token,
+    bool present,
+    VastWorkspaceGroupRegistry* registry,
+    std::string* error);
+
+}  // namespace vast
+
+#endif  // CHROME_BROWSER_VAST_VAST_WORKSPACE_GROUP_REGISTRY_H_
diff --git a/chrome/browser/vast/vast_workspace_group_registry_unittest.cc b/chrome/browser/vast/vast_workspace_group_registry_unittest.cc
new file mode 100644
index 0000000000..d016c4ca62
--- /dev/null
+++ b/chrome/browser/vast/vast_workspace_group_registry_unittest.cc
@@ -0,0 +1,146 @@
+// Copyright 2026 The Vast Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/vast/vast_workspace_group_registry.h"
+
+#include <string>
+#include <vector>
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/json/json_writer.h"
+#include "base/token.h"
+#include "base/values.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace vast {
+namespace {
+
+class VastWorkspaceGroupRegistryTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(temp_dir_.CreateUniqueTempDir());
+    profile_path_ = temp_dir_.GetPath().Append(FILE_PATH_LITERAL("Profile"));
+    ASSERT_TRUE(base::CreateDirectory(profile_path_));
+    journal_path_ =
+        temp_dir_.GetPath().Append(FILE_PATH_LITERAL("migration-journal.json"));
+  }
+
+  base::FilePath RegistryPath() const {
+    return profile_path_.Append(FILE_PATH_LITERAL("VastProductData"))
+        .Append(FILE_PATH_LITERAL("workspace-tab-groups.json"));
+  }
+
+  void WriteRegistry(base::DictValue root) {
+    ASSERT_TRUE(base::CreateDirectory(RegistryPath().DirName()));
+    std::string serialized;
+    ASSERT_TRUE(base::JSONWriter::Write(root, &serialized));
+    ASSERT_TRUE(base::WriteFile(RegistryPath(), serialized));
+  }
+
+  base::ScopedTempDir temp_dir_;
+  base::FilePath profile_path_;
+  base::FilePath journal_path_;
+  const std::vector<std::string> workspace_ids_ = {"one", "two"};
+};
+
+TEST_F(VastWorkspaceGroupRegistryTest,
+       PersistsUpdatesRemovesAndBindsToJournal) {
+  const std::string first_token = base::Token::CreateRandom().ToString();
+  const std::string second_token = base::Token::CreateRandom().ToString();
+  VastWorkspaceGroupRegistry registry;
+  std::string error;
+  ASSERT_TRUE(UpdateVastWorkspaceGroupRegistration(
+      profile_path_, journal_path_, workspace_ids_, "one", first_token, true,
+      &registry, &error))
+      << error;
+  ASSERT_TRUE(UpdateVastWorkspaceGroupRegistration(
+      profile_path_, journal_path_, workspace_ids_, "two", second_token, true,
+      &registry, &error))
+      << error;
+  ASSERT_EQ(registry.registrations.size(), 2u);
+
+  VastWorkspaceGroupRegistry loaded;
+  ASSERT_TRUE(LoadVastWorkspaceGroupRegistry(profile_path_, journal_path_,
+                                             workspace_ids_, &loaded, &error))
+      << error;
+  EXPECT_EQ(loaded.registrations, registry.registrations);
+  EXPECT_FALSE(loaded.stale);
+
+  ASSERT_TRUE(UpdateVastWorkspaceGroupRegistration(
+      profile_path_, journal_path_, workspace_ids_, "one", first_token, false,
+      &registry, &error))
+      << error;
+  ASSERT_EQ(registry.registrations.size(), 1u);
+  EXPECT_EQ(registry.registrations[0].group_token, second_token);
+
+  ASSERT_TRUE(LoadVastWorkspaceGroupRegistry(
+      profile_path_,
+      temp_dir_.GetPath().Append(FILE_PATH_LITERAL("other.json")),
+      workspace_ids_, &loaded, &error));
+  EXPECT_TRUE(loaded.stale);
+  EXPECT_TRUE(loaded.registrations.empty());
+}
+
+TEST_F(VastWorkspaceGroupRegistryTest, RejectsUnknownWorkspaceAndInvalidToken) {
+  VastWorkspaceGroupRegistry registry;
+  std::string error;
+  EXPECT_FALSE(UpdateVastWorkspaceGroupRegistration(
+      profile_path_, journal_path_, workspace_ids_, "unknown",
+      base::Token::CreateRandom().ToString(), true, &registry, &error));
+  EXPECT_FALSE(error.empty());
+  EXPECT_FALSE(UpdateVastWorkspaceGroupRegistration(
+      profile_path_, journal_path_, workspace_ids_, "one", "not-a-token", true,
+      &registry, &error));
+  EXPECT_FALSE(error.empty());
+  EXPECT_FALSE(base::PathExists(RegistryPath()));
+}
+
+TEST_F(VastWorkspaceGroupRegistryTest, RejectsDuplicateGroupTokens) {
+  const std::string token = base::Token::CreateRandom().ToString();
+  base::ListValue groups;
+  for (const std::string& workspace_id : workspace_ids_) {
+    base::DictValue group;
+    group.Set("workspaceId", workspace_id);
+    group.Set("groupToken", token);
+    groups.Append(std::move(group));
+  }
+  base::DictValue root;
+  root.Set("formatVersion", 1);
+  root.Set("journalPath", journal_path_.AsUTF8Unsafe());
+  root.Set("groups", std::move(groups));
+  WriteRegistry(std::move(root));
+
+  VastWorkspaceGroupRegistry registry;
+  std::string error;
+  EXPECT_FALSE(LoadVastWorkspaceGroupRegistry(
+      profile_path_, journal_path_, workspace_ids_, &registry, &error));
+  EXPECT_TRUE(registry.registrations.empty());
+  EXPECT_EQ(error,
+            "Vast workspace group registry contains a duplicate group token.");
+}
+
+TEST_F(VastWorkspaceGroupRegistryTest, RejectsUnsafeOrOversizedEnvelope) {
+  base::DictValue root;
+  root.Set("formatVersion", 1);
+  root.Set("journalPath", journal_path_.AsUTF8Unsafe());
+  root.Set("groups", base::ListValue());
+  root.Set("unexpected", true);
+  WriteRegistry(std::move(root));
+
+  VastWorkspaceGroupRegistry registry;
+  std::string error;
+  EXPECT_FALSE(LoadVastWorkspaceGroupRegistry(
+      profile_path_, journal_path_, workspace_ids_, &registry, &error));
+  EXPECT_EQ(error, "Vast workspace group registry has an invalid envelope.");
+
+  ASSERT_TRUE(base::WriteFile(RegistryPath(), std::string(64 * 1024 + 1, 'x')));
+  EXPECT_FALSE(LoadVastWorkspaceGroupRegistry(
+      profile_path_, journal_path_, workspace_ids_, &registry, &error));
+  EXPECT_EQ(error,
+            "Vast workspace group registry is unavailable or oversized.");
+}
+
+}  // namespace
+}  // namespace vast
