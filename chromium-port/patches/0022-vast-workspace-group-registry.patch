+void VastWorkspaceTabController::RequestApplyStatus(
+    vast::VastProductDataRootStatus status) {
+  const uint64_t generation = ++status_generation_;
+  if (!status.selected || !status.compatible || !status.projection.compatible ||
+      !tab_strip_model_->SupportsTabGroups()) {
+    registered_workspace_groups_.clear();
+    allow_title_recovery_ = false;
+    ApplyStatus(status);
+    return;
+  }
+  product_data_service_->GetWorkspaceGroupRegistry(base::BindOnce(
+      &VastWorkspaceTabController::OnWorkspaceGroupRegistryLoaded,
+      weak_ptr_factory_.GetWeakPtr(), generation, std::move(status)));
+}
+
+void VastWorkspaceTabController::OnWorkspaceGroupRegistryLoaded(
+    uint64_t status_generation,
+    vast::VastProductDataRootStatus status,
+    vast::VastWorkspaceGroupRegistryResult result) {
+  if (status_generation != status_generation_) {
+    return;
+  }
+  registered_workspace_groups_.clear();
+  allow_title_recovery_ = result.success;
+  if (!result.success) {
+    LOG(WARNING) << "Ignoring invalid Vast workspace group registry: "
+                 << result.error;
+  } else {
+    for (const vast::VastWorkspaceGroupRegistration& registration :
+         result.registry.registrations) {
+      const std::optional<base::Token> token =
+          base::Token::FromString(registration.group_token);
+      if (token && !token->is_zero()) {
+        registered_workspace_groups_.insert_or_assign(
+            tab_groups::TabGroupId::FromRawToken(*token),
+            registration.workspace_id);
+      }
+    }
+  }
+  ApplyStatus(status);
+}
