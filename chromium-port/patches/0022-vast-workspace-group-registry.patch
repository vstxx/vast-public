+                                             base::BindOnce(on_updated));
+    service.UpdateWorkspaceGroupRegistration("focus", second_token, true,
+                                             base::BindOnce(on_updated));
+    run_loop.Run();
+    EXPECT_EQ(callbacks, 2);
+  }
