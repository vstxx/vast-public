index 0000000000..41924657fb
--- /dev/null
+++ b/chrome/browser/vast/vast_workspace_group_registry.cc
@@ -0,0 +1,221 @@
+// Copyright 2026 The Vast Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/vast/vast_workspace_group_registry.h"
+
+#include <algorithm>
+#include <cstddef>
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/check.h"
+#include "base/files/file_util.h"
+#include "base/files/important_file_writer.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/token.h"
+#include "base/values.h"
+
+namespace vast {
+namespace {
+
+constexpr size_t kMaxRegistryBytes = 64 * 1024;
+constexpr size_t kMaxRegistrations = 128;
+constexpr size_t kMaxWorkspaceIdBytes = 256;
+constexpr size_t kMaxJournalPathBytes = 32768;
+constexpr base::FilePath::CharType kMetadataDirectory[] =
+    FILE_PATH_LITERAL("VastProductData");
+constexpr base::FilePath::CharType kRegistryFile[] =
+    FILE_PATH_LITERAL("workspace-tab-groups.json");
+
+base::FilePath RegistryPath(const base::FilePath& profile_path) {
+  return profile_path.Append(kMetadataDirectory).Append(kRegistryFile);
+}
+
+bool IsKnownWorkspace(base::span<const std::string> known_workspace_ids,
+                      std::string_view workspace_id) {
+  return std::ranges::find(known_workspace_ids, workspace_id) !=
+         known_workspace_ids.end();
+}
+
+bool IsCanonicalGroupToken(std::string_view group_token) {
+  const std::optional<base::Token> token = base::Token::FromString(group_token);
+  return token && !token->is_zero() && token->ToString() == group_token;
+}
+
+bool PersistRegistry(const base::FilePath& profile_path,
+                     const base::FilePath& journal_path,
+                     const VastWorkspaceGroupRegistry& registry,
+                     std::string* error) {
+  const base::FilePath registry_path = RegistryPath(profile_path);
+  if (!base::CreateDirectory(registry_path.DirName()) ||
+      base::IsLink(registry_path.DirName()) || base::IsLink(registry_path)) {
+    *error =
+        "Vast workspace group registry directory is unavailable or unsafe.";
+    return false;
+  }
+
+  base::ListValue groups;
+  for (const VastWorkspaceGroupRegistration& registration :
+       registry.registrations) {
+    base::DictValue group;
+    group.Set("workspaceId", registration.workspace_id);
+    group.Set("groupToken", registration.group_token);
+    groups.Append(std::move(group));
+  }
+  base::DictValue root;
+  root.Set("formatVersion", 1);
+  root.Set("journalPath", journal_path.AsUTF8Unsafe());
+  root.Set("groups", std::move(groups));
+  std::string serialized;
+  if (!base::JSONWriter::WriteWithOptions(
+          root, base::JSONWriter::OPTIONS_PRETTY_PRINT, &serialized)) {
+    *error = "Vast workspace group registry could not be serialized.";
+    return false;
+  }
+  serialized.push_back('\n');
+  if (serialized.size() > kMaxRegistryBytes ||
+      !base::ImportantFileWriter::WriteFileAtomically(registry_path,
+                                                      serialized)) {
+    *error = "Vast workspace group registry could not be written.";
+    return false;
+  }
+  return true;
+}
+
+}  // namespace
+
+bool LoadVastWorkspaceGroupRegistry(
+    const base::FilePath& profile_path,
+    const base::FilePath& journal_path,
+    base::span<const std::string> known_workspace_ids,
+    VastWorkspaceGroupRegistry* registry,
+    std::string* error) {
+  CHECK(registry);
+  CHECK(error);
+  *registry = VastWorkspaceGroupRegistry();
+  error->clear();
+  if (!profile_path.IsAbsolute() || !journal_path.IsAbsolute()) {
+    *error = "Vast workspace group registry paths must be absolute.";
+    return false;
+  }
+
+  const base::FilePath registry_path = RegistryPath(profile_path);
+  if (!base::PathExists(registry_path)) {
+    return true;
+  }
+  if (base::IsLink(registry_path) || base::IsLink(registry_path.DirName())) {
+    *error = "Vast workspace group registry must not be a link or junction.";
+    return false;
+  }
+
+  std::string contents;
+  if (!base::ReadFileToStringWithMaxSize(registry_path, &contents,
+                                         kMaxRegistryBytes)) {
+    *error = "Vast workspace group registry is unavailable or oversized.";
+    return false;
+  }
+  std::optional<base::DictValue> root =
+      base::JSONReader::ReadDict(contents, base::JSON_PARSE_RFC, 20);
+  if (!root) {
+    *error = "Vast workspace group registry is not valid JSON.";
+    return false;
+  }
+
+  const std::optional<int> format_version = root->FindInt("formatVersion");
+  const std::string* selected_journal = root->FindString("journalPath");
+  const base::ListValue* groups = root->FindList("groups");
+  if (root->size() != 3u || !format_version || *format_version != 1 ||
+      !selected_journal || selected_journal->empty() ||
+      selected_journal->size() > kMaxJournalPathBytes || !groups ||
+      groups->size() > kMaxRegistrations) {
+    *error = "Vast workspace group registry has an invalid envelope.";
+    return false;
+  }
+
+  const base::FilePath selected_journal_path =
+      base::FilePath::FromUTF8Unsafe(*selected_journal);
+  if (!selected_journal_path.IsAbsolute()) {
+    *error = "Vast workspace group registry journal path must be absolute.";
+    return false;
+  }
+  if (selected_journal_path != journal_path) {
+    registry->stale = true;
+    return true;
+  }
+
+  for (const base::Value& value : *groups) {
+    const base::DictValue* group = value.GetIfDict();
+    const std::string* workspace_id =
+        group ? group->FindString("workspaceId") : nullptr;
+    const std::string* group_token =
+        group ? group->FindString("groupToken") : nullptr;
+    if (!group || group->size() != 2u || !workspace_id ||
+        workspace_id->empty() || workspace_id->size() > kMaxWorkspaceIdBytes ||
+        !IsKnownWorkspace(known_workspace_ids, *workspace_id) || !group_token ||
+        !IsCanonicalGroupToken(*group_token)) {
+      *error = "Vast workspace group registry contains an invalid entry.";
+      registry->registrations.clear();
+      return false;
+    }
+    const bool duplicate_token = std::ranges::any_of(
+        registry->registrations,
+        [&](const VastWorkspaceGroupRegistration& registration) {
+          return registration.group_token == *group_token;
+        });
+    if (duplicate_token) {
+      *error =
+          "Vast workspace group registry contains a duplicate group token.";
+      registry->registrations.clear();
+      return false;
+    }
+    registry->registrations.push_back(
+        {.workspace_id = *workspace_id, .group_token = *group_token});
+  }
+  return true;
+}
+
+bool UpdateVastWorkspaceGroupRegistration(
+    const base::FilePath& profile_path,
+    const base::FilePath& journal_path,
+    base::span<const std::string> known_workspace_ids,
+    std::string_view workspace_id,
+    std::string_view group_token,
+    bool present,
+    VastWorkspaceGroupRegistry* registry,
+    std::string* error) {
+  CHECK(registry);
+  CHECK(error);
+  if (!IsKnownWorkspace(known_workspace_ids, workspace_id) ||
+      workspace_id.empty() || workspace_id.size() > kMaxWorkspaceIdBytes ||
+      !IsCanonicalGroupToken(group_token)) {
+    *error = "Vast workspace group registration is invalid.";
+    return false;
+  }
+  if (!LoadVastWorkspaceGroupRegistry(profile_path, journal_path,
+                                      known_workspace_ids, registry, error)) {
+    return false;
+  }
+
+  std::erase_if(registry->registrations,
+                [&](const VastWorkspaceGroupRegistration& registration) {
+                  return registration.group_token == group_token;
+                });
+  if (present) {
+    if (registry->registrations.size() >= kMaxRegistrations) {
+      *error = "Vast workspace group registry reached its entry limit.";
+      return false;
+    }
+    registry->registrations.push_back(
+        {.workspace_id = std::string(workspace_id),
+         .group_token = std::string(group_token)});
+  }
+  std::ranges::sort(registry->registrations, {},
+                    &VastWorkspaceGroupRegistration::group_token);
+  registry->stale = false;
+  return PersistRegistry(profile_path, journal_path, *registry, error);
+}
+
+}  // namespace vast
