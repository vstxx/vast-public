diff --git a/chrome/browser/vast/vast_data_migration_preview.cc b/chrome/browser/vast/vast_data_migration_preview.cc
new file mode 100644
index 0000000000000000000000000000000000000000..10b66e40b32767ffa080e6ef065629ee81098de6
--- /dev/null
+++ b/chrome/browser/vast/vast_data_migration_preview.cc
@@ -0,0 +1,156 @@
+// Copyright 2026 The Vast Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/vast/vast_data_migration_preview.h"
+
+#include <cstddef>
+#include <optional>
+#include <string_view>
+
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/values.h"
+
+namespace vast {
+namespace {
+
+constexpr size_t kMaxStorageBytes = 8 * 1024 * 1024;
+bool ReadCollectionCount(const base::DictValue& root,
+                         std::string_view key,
+                         size_t normalized_limit,
+                         bool required,
+                         uint32_t* count,
+                         std::string* error) {
+  const base::ListValue* list = root.FindList(key);
+  if (!list) {
+    if (!required && !root.Find(key)) {
+      *count = 0;
+      return true;
+    }
+    *error = "Vast data has a missing or invalid collection.";
+    return false;
+  }
+  if (list->size() > normalized_limit * 2) {
+    *error = "Vast data collection exceeds its safe preview limit.";
+    return false;
+  }
+  *count = static_cast<uint32_t>(list->size());
+  return true;
+}
+
+}  // namespace
+
+VastDataMigrationPreview ReadVastDataMigrationPreview(
+    const base::FilePath& data_root) {
+  VastDataMigrationPreview preview;
+  const base::FilePath data_path =
+      data_root.Append(FILE_PATH_LITERAL("vast-data.json"));
+  if (!base::PathExists(data_path)) {
+    preview.error = "Copied Vast data does not contain vast-data.json.";
+    return preview;
+  }
+
+  preview.available = true;
+  preview.password_vault_present = base::PathExists(
+      data_root.Append(FILE_PATH_LITERAL("password-vault.json")));
+
+  const std::optional<int64_t> file_size = base::GetFileSize(data_path);
+  if (!file_size || *file_size < 0 ||
+      *file_size > static_cast<int64_t>(kMaxStorageBytes)) {
+    preview.error = "Vast data file is unavailable or larger than 8 MiB.";
+    return preview;
+  }
+
+  std::string contents;
+  if (!base::ReadFileToStringWithMaxSize(data_path, &contents,
+                                         kMaxStorageBytes)) {
+    preview.error = "Vast data file could not be read safely.";
+    return preview;
+  }
+
+  std::optional<base::DictValue> root =
+      base::JSONReader::ReadDict(contents, base::JSON_PARSE_RFC, 100);
+  if (!root) {
+    preview.error = "Vast data file is not valid JSON.";
+    return preview;
+  }
+
+  const std::optional<int> schema_version = root->FindInt("schemaVersion");
+  if (!schema_version) {
+    preview.error = "Vast data schema version is missing.";
+    return preview;
+  }
+  preview.schema_version = *schema_version;
+  if (*schema_version < 1 || *schema_version > 5) {
+    preview.error = "Vast data schema version is not supported.";
+    return preview;
+  }
+
+  const std::string* active_workspace_id =
+      root->FindString("activeWorkspaceId");
+  if (!active_workspace_id || active_workspace_id->empty() ||
+      active_workspace_id->size() > 256) {
+    preview.error = "Vast data active workspace is invalid.";
+    return preview;
+  }
+
+  uint32_t ignored_count = 0;
+  if (!ReadCollectionCount(*root, "workspaces", 100, true, &preview.workspaces,
+                           &preview.error) ||
+      !ReadCollectionCount(*root, "tabGroups", 300, true, &ignored_count,
+                           &preview.error) ||
+      !ReadCollectionCount(*root, "tabs", 1200, true, &preview.tabs,
+                           &preview.error) ||
+      !ReadCollectionCount(*root, "recentlyClosedTabs", 80, false,
+                           &ignored_count, &preview.error) ||
+      !ReadCollectionCount(*root, "bookmarks", 5000, true, &preview.bookmarks,
+                           &preview.error) ||
+      !ReadCollectionCount(*root, "bookmarkFolders", 1000, true, &ignored_count,
+                           &preview.error) ||
+      !ReadCollectionCount(*root, "history", 1200, true, &preview.history,
+                           &preview.error) ||
+      !ReadCollectionCount(*root, "downloads", 250, true, &ignored_count,
+                           &preview.error) ||
+      !ReadCollectionCount(*root, "notes", 1000, true, &preview.notes,
+                           &preview.error) ||
+      !ReadCollectionCount(*root, "readingList", 1200, true, &ignored_count,
+                           &preview.error) ||
+      !ReadCollectionCount(*root, "quickLinks", 24, true, &ignored_count,
+                           &preview.error) ||
+      !ReadCollectionCount(*root, "siteMemory", 300, false, &ignored_count,
+                           &preview.error) ||
+      !ReadCollectionCount(*root, "todos", 300, false, &ignored_count,
+                           &preview.error) ||
+      !ReadCollectionCount(*root, "macros", 200, false, &ignored_count,
+                           &preview.error) ||
+      !ReadCollectionCount(*root, "macroLogs", 250, false, &ignored_count,
+                           &preview.error) ||
+      !ReadCollectionCount(*root, "sessionSnapshots", 100, false,
+                           &ignored_count, &preview.error) ||
+      !ReadCollectionCount(*root, "recentCommandIds", 32, false, &ignored_count,
+                           &preview.error)) {
+    return preview;
+  }
+
+  const base::DictValue* settings = root->FindDict("settings");
+  if (!settings) {
+    preview.error = "Vast data settings are missing or invalid.";
+    return preview;
+  }
+  constexpr std::string_view kSettingsSections[] = {
+      "appearance", "privacy", "advanced",     "security",
+      "network",    "reader",  "siteOverrides"};
+  for (std::string_view section : kSettingsSections) {
+    const base::Value* value = settings->Find(section);
+    if (value && !value->is_dict()) {
+      preview.error = "Vast data settings contain an invalid section.";
+      return preview;
+    }
+  }
+
+  preview.compatible = true;
+  return preview;
+}
+
+}  // namespace vast
