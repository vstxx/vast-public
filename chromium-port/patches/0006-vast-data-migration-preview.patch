+    const VastDataMigrationPreview& source) {
+  auto preview = mojom::MigrationPreview::New();
+  preview->available = source.available;
+  preview->compatible = source.compatible;
+  preview->schema_version = source.schema_version;
+  preview->workspaces = source.workspaces;
+  preview->tabs = source.tabs;
+  preview->bookmarks = source.bookmarks;
+  preview->notes = source.notes;
