+// Copyright 2026 The Vast Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_VAST_VAST_DATA_MIGRATION_PREVIEW_H_
+#define CHROME_BROWSER_VAST_VAST_DATA_MIGRATION_PREVIEW_H_
+
+#include <cstdint>
+#include <string>
+
+#include "base/files/file_path.h"
+
+namespace vast {
+
+// Aggregated, non-sensitive facts from a legacy Vast data root. This preview
+// never returns record contents, URLs, credentials, cookies, or file paths.
+struct VastDataMigrationPreview {
+  bool available = false;
+  bool compatible = false;
+  int32_t schema_version = -1;
+  uint32_t workspaces = 0;
+  uint32_t tabs = 0;
+  uint32_t bookmarks = 0;
+  uint32_t notes = 0;
+  uint32_t history = 0;
+  bool password_vault_present = false;
+  std::string error;
+};
+
+// Reads only vast-data.json metadata and checks for the presence of the vault.
+// The source directory is never modified.
+VastDataMigrationPreview ReadVastDataMigrationPreview(
+    const base::FilePath& data_root);
+
+}  // namespace vast
+
+#endif  // CHROME_BROWSER_VAST_VAST_DATA_MIGRATION_PREVIEW_H_
