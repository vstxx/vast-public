+void VastUI::GetMigrationPreview(GetMigrationPreviewCallback callback) {
+  const base::FilePath fixture_root =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+          kMigrationFixtureSwitch);
+  if (fixture_root.empty()) {
+    std::move(callback).Run(
+        ToMojomMigrationPreview(VastDataMigrationPreview()));
+    return;
+  }
+
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadVastDataMigrationPreview, fixture_root),
+      base::BindOnce(
+          [](GetMigrationPreviewCallback callback,
+             VastDataMigrationPreview preview) {
+            std::move(callback).Run(ToMojomMigrationPreview(preview));
+          },
+          std::move(callback)));
+}
+
