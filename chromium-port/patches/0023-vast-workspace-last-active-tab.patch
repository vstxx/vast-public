+std::optional<int> VastWorkspaceTabController::WorkspaceLastActiveTabIndex(
+    std::string_view workspace_id) const {
+  for (const auto& [group_id, registered_workspace_id] :
+       registered_workspace_groups_) {
+    if (registered_workspace_id != workspace_id) {
+      continue;
+    }
+    const auto active_index =
+        registered_last_active_tab_indices_.find(group_id);
+    if (active_index != registered_last_active_tab_indices_.end()) {
+      return active_index->second;
+    }
+  }
+  return std::nullopt;
+}
+
+void VastWorkspaceTabController::RememberActiveTab(
+    std::string workspace_id,
+    tab_groups::TabGroupId group_id,
+    tabs::TabInterface* tab,
+    bool persist) {
+  const std::optional<int> relative_index = RelativeTabIndex(group_id, tab);
+  if (!relative_index) {
+    return;
+  }
+  last_active_tabs_.insert_or_assign(workspace_id, tab->GetWeakPtr());
+  registered_workspace_groups_.insert_or_assign(group_id, workspace_id);
+  for (const auto& [registered_group_id, registered_workspace_id] :
+       registered_workspace_groups_) {
+    if (registered_workspace_id == workspace_id) {
+      registered_last_active_tab_indices_.insert_or_assign(registered_group_id,
+                                                           *relative_index);
+    }
+  }
+  if (persist) {
+    product_data_service_->UpdateWorkspaceGroupRegistration(
+        std::move(workspace_id), group_id.ToString(), relative_index, true,
+        base::BindOnce(&VastWorkspaceTabController::OnWorkspaceGroupRegistered,
+                       weak_ptr_factory_.GetWeakPtr()));
+  }
+}
