+TEST_F(VastWorkspaceGroupRegistryTest,
+       PropagatesWorkspaceIndexAcrossRemappedTokensAndRejectsConflict) {
+  const std::string first_token = base::Token::CreateRandom().ToString();
+  const std::string second_token = base::Token::CreateRandom().ToString();
+  VastWorkspaceGroupRegistry registry;
+  std::string error;
+  ASSERT_TRUE(UpdateVastWorkspaceGroupRegistration(
+      profile_path_, journal_path_, workspace_ids_, "one", first_token, 1, true,
+      &registry, &error))
+      << error;
+  ASSERT_TRUE(UpdateVastWorkspaceGroupRegistration(
+      profile_path_, journal_path_, workspace_ids_, "one", second_token, 3,
+      true, &registry, &error))
+      << error;
+  ASSERT_EQ(registry.registrations.size(), 2u);
+  EXPECT_EQ(registry.registrations[0].last_active_tab_index, 3);
+  EXPECT_EQ(registry.registrations[1].last_active_tab_index, 3);
+
+  base::ListValue groups;
+  for (int index = 0; index < 2; ++index) {
+    base::DictValue group;
+    group.Set("workspaceId", "one");
+    group.Set("groupToken", index == 0 ? first_token : second_token);
+    group.Set("lastActiveTabIndex", index);
+    groups.Append(std::move(group));
+  }
+  base::DictValue root;
+  root.Set("formatVersion", 1);
+  root.Set("journalPath", journal_path_.AsUTF8Unsafe());
+  root.Set("groups", std::move(groups));
+  WriteRegistry(std::move(root));
+
+  EXPECT_FALSE(LoadVastWorkspaceGroupRegistry(
+      profile_path_, journal_path_, workspace_ids_, &registry, &error));
+  EXPECT_EQ(error,
+            "Vast workspace group registry contains conflicting active tab "
+            "positions.");
+}
