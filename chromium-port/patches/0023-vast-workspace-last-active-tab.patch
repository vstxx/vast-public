+std::optional<int> VastWorkspaceTabController::RelativeTabIndex(
+    tab_groups::TabGroupId group_id,
+    const tabs::TabInterface* tab) const {
+  if (!tab || !tab_strip_model_->group_model()->ContainsTabGroup(group_id)) {
+    return std::nullopt;
+  }
+  const int tab_index = tab_strip_model_->GetIndexOfTab(tab);
+  const gfx::Range group_range =
+      tab_strip_model_->group_model()->GetTabGroup(group_id)->ListTabs();
+  const int group_start = static_cast<int>(group_range.start());
+  const int group_end = static_cast<int>(group_range.end());
+  if (tab_index < group_start || tab_index >= group_end) {
+    return std::nullopt;
+  }
+  return tab_index - group_start;
+}
