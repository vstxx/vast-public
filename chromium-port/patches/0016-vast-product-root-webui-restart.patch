+function showProductDataStatus(
+    selected: boolean, compatible: boolean, schemaVersion: number,
+    workspaces: number, theme: string, error: string) {
+  const element = getElement<HTMLParagraphElement>('product-data-status');
+  if (!selected) {
+    document.documentElement.dataset['productData'] = 'not-selected';
+    element.hidden = true;
+    return;
+  }
+  element.hidden = false;
+  if (!compatible) {
+    document.documentElement.dataset['productData'] = 'invalid';
+    element.textContent = error || 'Selected Vast 2 product data is invalid.';
+    return;
+  }
+  document.documentElement.dataset['productData'] = 'recovered';
+  element.textContent =
+      `Vast 2 data recovered: schema ${schemaVersion}, ${workspaces} ` +
+      `workspace(s), ${theme} theme.`;
+}
