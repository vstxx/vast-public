+bool IsMigrationFixtureCommitEnabled() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  return command_line->HasSwitch(kEnableMigrationFixtureCommitSwitch) &&
+         !command_line->GetSwitchValuePath(kMigrationFixtureSwitch).empty() &&
+         !command_line->GetSwitchValuePath(kMigrationTransactionParentSwitch)
+              .empty();
