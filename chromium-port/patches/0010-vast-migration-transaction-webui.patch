+// Non-sensitive outcome from the development-fixture transaction. Native
+// paths, record contents, checksums, and credentials never cross this boundary.
+struct MigrationTransactionResult {
+  bool attempted;
+  bool prepared;
+  bool committed;
+  bool rolled_back;
+  uint32 files;
+  string state;
