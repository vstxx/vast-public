+mojom::MigrationTransactionResultPtr ToMojomMigrationTransactionResult(
+    const VastDataMigrationTransaction& transaction,
+    bool attempted) {
+  auto result = mojom::MigrationTransactionResult::New();
+  result->attempted = attempted;
+  result->prepared = transaction.state == VastDataMigrationState::kPrepared ||
+                     transaction.state == VastDataMigrationState::kCommitted ||
+                     transaction.state == VastDataMigrationState::kRolledBack;
+  result->committed = transaction.state == VastDataMigrationState::kCommitted;
+  result->rolled_back =
+      transaction.state == VastDataMigrationState::kRolledBack;
+  result->files = static_cast<uint32_t>(transaction.files.size());
+  switch (transaction.state) {
+    case VastDataMigrationState::kFailed:
+      result->state = "failed";
+      break;
+    case VastDataMigrationState::kPrepared:
+      result->state = "prepared";
+      break;
+    case VastDataMigrationState::kCommitted:
+      result->state = "committed";
+      break;
+    case VastDataMigrationState::kRolledBack:
+      result->state = "rolled-back";
+      break;
+  }
+  result->error = transaction.error;
+  return result;
+}
+
+mojom::MigrationTransactionResultPtr MigrationTransactionError(
+    std::string error,
+    bool attempted) {
+  VastDataMigrationTransaction transaction;
+  transaction.error = std::move(error);
+  return ToMojomMigrationTransactionResult(transaction, attempted);
+}
+
+VastDataMigrationTransaction RunMigrationFixtureTransactionOnWorker() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  const base::FilePath fixture_root =
+      command_line->GetSwitchValuePath(kMigrationFixtureSwitch);
+  const base::FilePath transaction_parent =
+      command_line->GetSwitchValuePath(kMigrationTransactionParentSwitch);
+  VastDataMigrationTransaction transaction = PrepareVastDataMigration(
+      fixture_root, transaction_parent,
+      transaction_parent.Append(kMigrationDestinationName));
+  if (transaction.state == VastDataMigrationState::kPrepared) {
+    CommitVastDataMigration(&transaction);
+  }
+  return transaction;
+}
+
+VastDataMigrationTransaction RollbackMigrationFixtureTransactionOnWorker(
+    VastDataMigrationTransaction transaction) {
+  RollbackVastDataMigration(&transaction);
+  return transaction;
+}
