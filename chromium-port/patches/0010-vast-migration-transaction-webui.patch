           std::move(callback)));
 }
 
+void VastUI::RunMigrationFixtureTransaction(
+    bool confirmed,
+    RunMigrationFixtureTransactionCallback callback) {
+  if (!confirmed) {
+    std::move(callback).Run(MigrationTransactionError(
+        "Explicit migration confirmation is required.", false));
+    return;
+  }
+  if (!IsMigrationFixtureCommitEnabled()) {
+    std::move(callback).Run(MigrationTransactionError(
+        "Development fixture migration is disabled.", false));
+    return;
+  }
+  if (migration_task_in_progress_) {
+    std::move(callback).Run(MigrationTransactionError(
+        "A migration task is already running.", false));
+    return;
+  }
+  if (migration_transaction_) {
+    std::move(callback).Run(MigrationTransactionError(
+        "This page already ran its one-shot migration transaction.", false));
+    return;
+  }
+
+  migration_task_in_progress_ = true;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&RunMigrationFixtureTransactionOnWorker),
+      base::BindOnce(&VastUI::OnMigrationFixtureTransactionComplete,
+                     weak_ptr_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void VastUI::RollbackMigrationFixtureTransaction(
+    bool confirmed,
+    RollbackMigrationFixtureTransactionCallback callback) {
+  if (!confirmed) {
+    std::move(callback).Run(MigrationTransactionError(
+        "Explicit rollback confirmation is required.", false));
+    return;
+  }
+  if (migration_task_in_progress_) {
+    std::move(callback).Run(MigrationTransactionError(
+        "A migration task is already running.", false));
+    return;
+  }
+  if (!migration_transaction_ ||
+      (migration_transaction_->state != VastDataMigrationState::kPrepared &&
+       migration_transaction_->state != VastDataMigrationState::kCommitted)) {
+    std::move(callback).Run(MigrationTransactionError(
+        "There is no prepared or committed fixture migration to roll back.",
+        false));
+    return;
+  }
+
+  migration_task_in_progress_ = true;
+  VastDataMigrationTransaction transaction = std::move(*migration_transaction_);
+  migration_transaction_.reset();
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&RollbackMigrationFixtureTransactionOnWorker,
+                     std::move(transaction)),
+      base::BindOnce(&VastUI::OnMigrationFixtureRollbackComplete,
+                     weak_ptr_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void VastUI::OnMigrationFixtureTransactionComplete(
+    RunMigrationFixtureTransactionCallback callback,
+    VastDataMigrationTransaction transaction) {
+  migration_task_in_progress_ = false;
+  auto result = ToMojomMigrationTransactionResult(transaction, true);
+  if (transaction.state == VastDataMigrationState::kPrepared ||
+      transaction.state == VastDataMigrationState::kCommitted) {
+    migration_transaction_ = std::move(transaction);
+  }
+  std::move(callback).Run(std::move(result));
+}
+
+void VastUI::OnMigrationFixtureRollbackComplete(
+    RollbackMigrationFixtureTransactionCallback callback,
+    VastDataMigrationTransaction transaction) {
+  migration_task_in_progress_ = false;
+  auto result = ToMojomMigrationTransactionResult(transaction, true);
+  migration_transaction_ = std::move(transaction);
+  std::move(callback).Run(std::move(result));
+}
+
 WEB_UI_CONTROLLER_TYPE_IMPL(VastUI)
 
 }  // namespace vast
