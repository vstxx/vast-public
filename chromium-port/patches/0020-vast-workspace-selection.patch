+      base::BindOnce(&PersistWorkspaceSelectionOnWorker, profile_path_,
+                     journal_path, std::move(workspace_id)),
+      base::BindOnce(&VastProductDataService::OnWorkspaceSelectionPersisted,
+                     weak_ptr_factory_.GetWeakPtr(),
+                     std::move(reload_workspace_id), std::move(callback),
+                     std::move(status)));
+}
+
+void VastProductDataService::OnWorkspaceSelectionPersisted(
+    std::string workspace_id,
+    WorkspaceSelectionCallback callback,
+    VastProductDataRootStatus previous_status,
+    std::string error) {
+  if (!error.empty()) {
+    VastWorkspaceSelectionResult result;
+    result.status = std::move(previous_status);
+    result.error = std::move(error);
+    FinishWorkspaceSelection(std::move(callback), std::move(result));
+    return;
+  }
+
+  Invalidate();
+  GetStatus(
+      base::BindOnce(&VastProductDataService::OnWorkspaceSelectionReloaded,
+                     weak_ptr_factory_.GetWeakPtr(), std::move(workspace_id),
+                     std::move(callback)));
+}
+
+void VastProductDataService::OnWorkspaceSelectionReloaded(
+    std::string workspace_id,
+    WorkspaceSelectionCallback callback,
+    VastProductDataRootStatus status) {
+  VastWorkspaceSelectionResult result;
+  result.status = std::move(status);
+  const auto workspace = std::ranges::find_if(
+      result.status.projection.workspaces,
+      [&](const VastWorkspaceProjection& candidate) {
+        return candidate.id == workspace_id && candidate.active;
+      });
+  if (result.status.compatible && result.status.projection.compatible &&
+      workspace != result.status.projection.workspaces.end()) {
+    result.success = true;
+  } else {
+    result.error = result.status.error.empty()
+                       ? "Vast workspace selection did not survive reload."
+                       : result.status.error;
+  }
+  FinishWorkspaceSelection(std::move(callback), std::move(result));
+}
+
+void VastProductDataService::FinishWorkspaceSelection(
+    WorkspaceSelectionCallback callback,
+    VastWorkspaceSelectionResult result) {
+  workspace_selection_in_progress_ = false;
+  std::move(callback).Run(std::move(result));
+}
+
 }  // namespace vast
