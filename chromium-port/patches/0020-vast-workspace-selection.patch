+  std::string error;
+  if (!ApplyVastWorkspaceSelection(profile_path,
+                                   status.transaction.journal_path,
+                                   &status.projection, &applied, &error)) {
+    LOG(WARNING) << "Ignoring invalid Vast workspace selection: " << error;
+  }
+  return status;
+}
