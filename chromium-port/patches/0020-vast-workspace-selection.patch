+VastProductDataRootStatus RecoverVastProductDataWithWorkspaceSelection(
+    const base::FilePath& profile_path) {
+  VastProductDataRootStatus status = RecoverVastProductDataRoot(profile_path);
+  if (!status.selected || !status.compatible || !status.projection.compatible ||
+      status.transaction.journal_path.empty()) {
+    return status;
