+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace vast {
+namespace {
+
+VastDataProjection CreateProjection() {
+  VastDataProjection projection;
+  projection.compatible = true;
+  projection.schema_version = 5;
+  projection.workspaces = {
+      {.id = "one", .name = "One", .order = 0, .active = true},
+      {.id = "two", .name = "Two", .order = 1, .active = false},
+  };
+  return projection;
+}
+
+class VastWorkspaceSelectionTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(temp_dir_.CreateUniqueTempDir());
+    profile_path_ = temp_dir_.GetPath().Append(FILE_PATH_LITERAL("Profile"));
+    ASSERT_TRUE(base::CreateDirectory(profile_path_));
+    journal_path_ =
+        temp_dir_.GetPath().Append(FILE_PATH_LITERAL("migration-journal.json"));
+  }
+
+  base::ScopedTempDir temp_dir_;
+  base::FilePath profile_path_;
+  base::FilePath journal_path_;
+};
+
+TEST_F(VastWorkspaceSelectionTest, PersistsAndAppliesKnownWorkspace) {
+  std::string error;
+  ASSERT_TRUE(PersistVastWorkspaceSelection(profile_path_, journal_path_, "two",
+                                            &error))
+      << error;
+  VastDataProjection projection = CreateProjection();
+  bool applied = false;
+  ASSERT_TRUE(ApplyVastWorkspaceSelection(profile_path_, journal_path_,
+                                          &projection, &applied, &error))
+      << error;
+  EXPECT_TRUE(applied);
+  EXPECT_FALSE(projection.workspaces[0].active);
+  EXPECT_TRUE(projection.workspaces[1].active);
+}
+
+TEST_F(VastWorkspaceSelectionTest, IgnoresSelectionForDifferentMigration) {
+  std::string error;
+  ASSERT_TRUE(PersistVastWorkspaceSelection(profile_path_, journal_path_, "two",
+                                            &error))
+      << error;
+  VastDataProjection projection = CreateProjection();
+  bool applied = true;
+  ASSERT_TRUE(ApplyVastWorkspaceSelection(
+      profile_path_,
+      temp_dir_.GetPath().Append(FILE_PATH_LITERAL("other.json")), &projection,
+      &applied, &error));
+  EXPECT_FALSE(applied);
+  EXPECT_TRUE(projection.workspaces[0].active);
+  EXPECT_FALSE(projection.workspaces[1].active);
+}
+
+TEST_F(VastWorkspaceSelectionTest,
+       RejectsUnknownWorkspaceWithoutChangingState) {
+  std::string error;
+  ASSERT_TRUE(PersistVastWorkspaceSelection(profile_path_, journal_path_,
+                                            "unknown", &error))
+      << error;
+  VastDataProjection projection = CreateProjection();
+  bool applied = false;
+  EXPECT_FALSE(ApplyVastWorkspaceSelection(profile_path_, journal_path_,
+                                           &projection, &applied, &error));
+  EXPECT_FALSE(applied);
+  EXPECT_EQ(error, "Vast workspace selection references an unknown workspace.");
+  EXPECT_TRUE(projection.workspaces[0].active);
+  EXPECT_FALSE(projection.workspaces[1].active);
+}
