new file mode 100644
index 0000000000000000000000000000000000000000..575dfdabfa44c3a510d51530dc911146b08a12ec
--- /dev/null
+++ b/chrome/browser/vast/vast_workspace_selection.cc
@@ -0,0 +1,151 @@
+// Copyright 2026 The Vast Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/vast/vast_workspace_selection.h"
+
+#include <algorithm>
+#include <cstddef>
+#include <optional>
+#include <string>
+
+#include "base/check.h"
+#include "base/files/file_util.h"
+#include "base/files/important_file_writer.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/values.h"
+
+namespace vast {
+namespace {
+
+constexpr size_t kMaxSelectionBytes = 64 * 1024;
+constexpr size_t kMaxWorkspaceIdBytes = 256;
+constexpr size_t kMaxJournalPathBytes = 32768;
+constexpr base::FilePath::CharType kMetadataDirectory[] =
+    FILE_PATH_LITERAL("VastProductData");
+constexpr base::FilePath::CharType kSelectionFile[] =
+    FILE_PATH_LITERAL("workspace-selection.json");
+
+base::FilePath SelectionPath(const base::FilePath& profile_path) {
+  return profile_path.Append(kMetadataDirectory).Append(kSelectionFile);
+}
+
+}  // namespace
+
+bool ApplyVastWorkspaceSelection(const base::FilePath& profile_path,
+                                 const base::FilePath& journal_path,
+                                 VastDataProjection* projection,
+                                 bool* applied,
+                                 std::string* error) {
+  CHECK(projection);
+  CHECK(applied);
+  CHECK(error);
+  *applied = false;
+  error->clear();
+
+  const base::FilePath selection_path = SelectionPath(profile_path);
+  if (!base::PathExists(selection_path)) {
+    return true;
+  }
+  if (base::IsLink(selection_path) || base::IsLink(selection_path.DirName())) {
+    *error =
+        "Vast workspace selection metadata must not be a link or junction.";
+    return false;
+  }
+
+  std::string contents;
+  if (!base::ReadFileToStringWithMaxSize(selection_path, &contents,
+                                         kMaxSelectionBytes)) {
+    *error = "Vast workspace selection metadata is unavailable or oversized.";
+    return false;
+  }
+  std::optional<base::DictValue> root =
+      base::JSONReader::ReadDict(contents, base::JSON_PARSE_RFC, 20);
+  if (!root) {
+    *error = "Vast workspace selection metadata is not valid JSON.";
+    return false;
+  }
+
+  const std::optional<int> format_version = root->FindInt("formatVersion");
+  const std::string* selected_journal = root->FindString("journalPath");
+  const std::string* workspace_id = root->FindString("workspaceId");
+  if (!format_version || *format_version != 1 || !selected_journal ||
+      selected_journal->empty() ||
+      selected_journal->size() > kMaxJournalPathBytes || !workspace_id ||
+      workspace_id->empty() || workspace_id->size() > kMaxWorkspaceIdBytes) {
+    *error = "Vast workspace selection has an invalid envelope.";
+    return false;
+  }
+
+  const base::FilePath selected_journal_path =
+      base::FilePath::FromUTF8Unsafe(*selected_journal);
+  if (!selected_journal_path.IsAbsolute()) {
+    *error = "Vast workspace selection journal path must be absolute.";
+    return false;
+  }
+  if (selected_journal_path != journal_path) {
+    return true;
+  }
+
+  const auto selected_workspace = std::ranges::find_if(
+      projection->workspaces, [&](const VastWorkspaceProjection& workspace) {
+        return workspace.id == *workspace_id;
+      });
+  if (selected_workspace == projection->workspaces.end()) {
+    *error = "Vast workspace selection references an unknown workspace.";
+    return false;
+  }
+  for (VastWorkspaceProjection& workspace : projection->workspaces) {
+    workspace.active = workspace.id == *workspace_id;
+  }
+  *applied = true;
+  return true;
+}
+
+bool PersistVastWorkspaceSelection(const base::FilePath& profile_path,
+                                   const base::FilePath& journal_path,
+                                   std::string_view workspace_id,
+                                   std::string* error) {
+  CHECK(error);
+  error->clear();
+  if (!profile_path.IsAbsolute()) {
+    *error = "Vast workspace selection profile path must be absolute.";
+    return false;
+  }
+  if (!journal_path.IsAbsolute()) {
+    *error = "Vast workspace selection journal path must be absolute.";
+    return false;
+  }
+  if (workspace_id.empty() || workspace_id.size() > kMaxWorkspaceIdBytes) {
+    *error = "Vast workspace selection ID is invalid.";
+    return false;
+  }
+
+  const base::FilePath selection_path = SelectionPath(profile_path);
+  if (!base::CreateDirectory(selection_path.DirName()) ||
+      base::IsLink(selection_path.DirName()) || base::IsLink(selection_path)) {
+    *error = "Vast workspace selection directory is unavailable or unsafe.";
+    return false;
+  }
+
+  base::DictValue root;
+  root.Set("formatVersion", 1);
+  root.Set("journalPath", journal_path.AsUTF8Unsafe());
+  root.Set("workspaceId", std::string(workspace_id));
+  std::string serialized;
+  if (!base::JSONWriter::WriteWithOptions(
+          root, base::JSONWriter::OPTIONS_PRETTY_PRINT, &serialized)) {
+    *error = "Vast workspace selection could not be serialized.";
+    return false;
+  }
+  serialized.push_back('\n');
+  if (!base::ImportantFileWriter::WriteFileAtomically(selection_path,
+                                                      serialized)) {
+    *error = "Vast workspace selection could not be written.";
+    return false;
+  }
+  return true;
+}
+
+}  // namespace vast
