+
+namespace vast {
+
+// Applies a profile-local selection only when it belongs to the currently
+// recovered migration journal and references a validated workspace. Absence or
+// a record for a different migrated root is a successful no-op.
+bool ApplyVastWorkspaceSelection(const base::FilePath& profile_path,
+                                 const base::FilePath& journal_path,
+                                 VastDataProjection* projection,
+                                 bool* applied,
+                                 std::string* error);
+
+// Persists only workspace identity below the Chromium profile. The recovered
+// Vast product root and legacy vast-data.json remain read-only.
+bool PersistVastWorkspaceSelection(const base::FilePath& profile_path,
+                                   const base::FilePath& journal_path,
+                                   std::string_view workspace_id,
+                                   std::string* error);
+
+}  // namespace vast
