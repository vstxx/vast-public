new file mode 100644
index 0000000000000000000000000000000000000000..565b78e12886a32befd98a1322984139352f3ec1
--- /dev/null
+++ b/chrome/browser/vast/vast_product_data_service_unittest.cc
@@ -0,0 +1,126 @@
+// Copyright 2026 The Vast Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/vast/vast_product_data_service.h"
+
+#include <string>
+#include <string_view>
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/functional/bind.h"
+#include "base/run_loop.h"
+#include "base/test/task_environment.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace vast {
+namespace {
+
+constexpr char kValidVastData[] = R"({
+  "schemaVersion": 5,
+  "activeWorkspaceId": "workspace",
+  "workspaces": [
+    {"id":"workspace","name":"Workspace","icon":"home","color":"#123456","order":0}
+  ],
+  "tabGroups": [],
+  "tabs": [],
+  "bookmarks": [],
+  "bookmarkFolders": [],
+  "history": [],
+  "downloads": [],
+  "notes": [],
+  "readingList": [],
+  "quickLinks": [],
+  "settings": {"theme":"dark"}
+})";
+
+class VastProductDataServiceTest : public testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(temp_dir_.CreateUniqueTempDir()); }
+
+  base::FilePath CreateDirectory(std::string_view name) {
+    const base::FilePath path = temp_dir_.GetPath().AppendASCII(name);
+    EXPECT_TRUE(base::CreateDirectory(path));
+    return path;
+  }
+
+  void Write(const base::FilePath& path, std::string_view contents) {
+    ASSERT_TRUE(base::CreateDirectory(path.DirName()));
+    ASSERT_TRUE(base::WriteFile(path, contents));
+  }
+
+  VastDataMigrationTransaction CommitFixture(const base::FilePath& source,
+                                             const base::FilePath& parent) {
+    Write(source.Append(FILE_PATH_LITERAL("vast-data.json")), kValidVastData);
+    VastDataMigrationTransaction transaction = PrepareVastDataMigration(
+        source, parent, parent.Append(FILE_PATH_LITERAL("Vast2Data")));
+    EXPECT_EQ(transaction.state, VastDataMigrationState::kPrepared)
+        << transaction.error;
+    EXPECT_TRUE(CommitVastDataMigration(&transaction)) << transaction.error;
+    return transaction;
+  }
+
+  VastProductDataRootStatus GetStatus(VastProductDataService* service) {
+    VastProductDataRootStatus result;
+    base::RunLoop run_loop;
+    service->GetStatus(base::BindOnce(
+        [](VastProductDataRootStatus* output, base::OnceClosure quit,
+           VastProductDataRootStatus status) {
+          *output = std::move(status);
+          std::move(quit).Run();
+        },
+        &result, run_loop.QuitClosure()));
+    run_loop.Run();
+    return result;
+  }
+
+  base::test::TaskEnvironment task_environment_;
+  base::ScopedTempDir temp_dir_;
+};
+
+TEST_F(VastProductDataServiceTest, SharesCachedStatusAndRevalidatesOnDemand) {
+  const base::FilePath source = CreateDirectory("Source");
+  const base::FilePath transactions = CreateDirectory("Transactions");
+  const base::FilePath profile = CreateDirectory("Profile");
+  VastDataMigrationTransaction transaction =
+      CommitFixture(source, transactions);
+  std::string error;
+  ASSERT_TRUE(ActivateVastProductDataRoot(profile, transaction, &error))
+      << error;
+  VastProductDataService service(profile);
+
+  const VastProductDataRootStatus first = GetStatus(&service);
+  ASSERT_TRUE(first.compatible) << first.error;
+  ASSERT_EQ(first.projection.workspaces.size(), 1u);
+  EXPECT_EQ(first.projection.workspaces[0].name, "Workspace");
+
+  Write(
+      transaction.destination_root.Append(FILE_PATH_LITERAL("vast-data.json")),
+      "tampered after service recovery");
+  const VastProductDataRootStatus cached = GetStatus(&service);
+  EXPECT_TRUE(cached.compatible);
+
+  service.Invalidate();
+  const VastProductDataRootStatus revalidated = GetStatus(&service);
+  EXPECT_TRUE(revalidated.selected);
+  EXPECT_FALSE(revalidated.compatible);
+  EXPECT_EQ(revalidated.error,
+            "Recovered Vast product data has an unexpected file size.");
+}
+
+TEST_F(VastProductDataServiceTest, CachesAnUnselectedProfile) {
+  const base::FilePath profile = CreateDirectory("Profile");
+  VastProductDataService service(profile);
+
+  const VastProductDataRootStatus first = GetStatus(&service);
+  const VastProductDataRootStatus second = GetStatus(&service);
+
+  EXPECT_FALSE(first.selected);
+  EXPECT_TRUE(first.error.empty());
+  EXPECT_FALSE(second.selected);
+  EXPECT_TRUE(second.error.empty());
+}
+
+}  // namespace
+}  // namespace vast
