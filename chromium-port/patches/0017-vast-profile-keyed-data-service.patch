@@ -0,0 +1,56 @@
+// Copyright 2026 The Vast Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_VAST_VAST_PRODUCT_DATA_SERVICE_H_
+#define CHROME_BROWSER_VAST_VAST_PRODUCT_DATA_SERVICE_H_
+
+#include <optional>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/vast/vast_product_data_root.h"
+#include "components/keyed_service/core/keyed_service.h"
+
+namespace vast {
+
+// Profile-scoped owner of recovered Vast product-data state. Blocking
+// verification stays on the ThreadPool and multiple WebUI controllers share
+// one validated snapshot per browser process.
+class VastProductDataService : public KeyedService {
+ public:
+  using StatusCallback = base::OnceCallback<void(VastProductDataRootStatus)>;
+
+  explicit VastProductDataService(base::FilePath profile_path);
+  ~VastProductDataService() override;
+
+  VastProductDataService(const VastProductDataService&) = delete;
+  VastProductDataService& operator=(const VastProductDataService&) = delete;
+
+  void GetStatus(StatusCallback callback);
+
+  // Forces the next status request to revalidate disk state. If verification
+  // is already running, queued callers wait for one fresh follow-up pass.
+  void Invalidate();
+
+  // KeyedService:
+  void Shutdown() override;
+
+ private:
+  void StartRecovery();
+  void OnRecoveryComplete(VastProductDataRootStatus status);
+
+  const base::FilePath profile_path_;
+  std::optional<VastProductDataRootStatus> cached_status_;
+  std::vector<StatusCallback> pending_callbacks_;
+  bool recovery_in_progress_ = false;
+  bool reload_after_recovery_ = false;
+  bool shutdown_ = false;
+  base::WeakPtrFactory<VastProductDataService> weak_ptr_factory_{this};
+};
+
+}  // namespace vast
+
+#endif  // CHROME_BROWSER_VAST_VAST_PRODUCT_DATA_SERVICE_H_
