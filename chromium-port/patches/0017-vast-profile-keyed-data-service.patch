diff --git a/chrome/browser/vast/vast_product_data_service.cc b/chrome/browser/vast/vast_product_data_service.cc
new file mode 100644
index 0000000000000000000000000000000000000000..162b27aad89415756faca2528734987a8b2fb142
--- /dev/null
+++ b/chrome/browser/vast/vast_product_data_service.cc
@@ -0,0 +1,75 @@
+// Copyright 2026 The Vast Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/vast/vast_product_data_service.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/task/thread_pool.h"
+
+namespace vast {
+
+VastProductDataService::VastProductDataService(base::FilePath profile_path)
+    : profile_path_(std::move(profile_path)) {}
+
+VastProductDataService::~VastProductDataService() = default;
+
+void VastProductDataService::GetStatus(StatusCallback callback) {
+  if (shutdown_) {
+    VastProductDataRootStatus status;
+    status.error = "The Vast product-data service is shutting down.";
+    std::move(callback).Run(std::move(status));
+    return;
+  }
+  if (cached_status_ && !recovery_in_progress_) {
+    std::move(callback).Run(*cached_status_);
+    return;
+  }
+  pending_callbacks_.push_back(std::move(callback));
+  if (!recovery_in_progress_) {
+    StartRecovery();
+  }
+}
+
+void VastProductDataService::Invalidate() {
+  cached_status_.reset();
+  if (recovery_in_progress_) {
+    reload_after_recovery_ = true;
+  }
+}
+
+void VastProductDataService::Shutdown() {
+  shutdown_ = true;
+  cached_status_.reset();
+  pending_callbacks_.clear();
+  weak_ptr_factory_.InvalidateWeakPtrs();
+}
+
+void VastProductDataService::StartRecovery() {
+  recovery_in_progress_ = true;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&RecoverVastProductDataRoot, profile_path_),
+      base::BindOnce(&VastProductDataService::OnRecoveryComplete,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void VastProductDataService::OnRecoveryComplete(
+    VastProductDataRootStatus status) {
+  recovery_in_progress_ = false;
+  if (reload_after_recovery_) {
+    reload_after_recovery_ = false;
+    StartRecovery();
+    return;
+  }
+  cached_status_ = std::move(status);
+  std::vector<StatusCallback> callbacks = std::move(pending_callbacks_);
+  pending_callbacks_.clear();
+  for (StatusCallback& callback : callbacks) {
+    std::move(callback).Run(*cached_status_);
+  }
+}
+
+}  // namespace vast
diff --git a/chrome/browser/vast/vast_product_data_service.h b/chrome/browser/vast/vast_product_data_service.h
