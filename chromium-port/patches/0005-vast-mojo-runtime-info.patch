diff --git a/chrome/browser/ui/webui/vast/vast.mojom b/chrome/browser/ui/webui/vast/vast.mojom
new file mode 100644
index 0000000000000000000000000000000000000000..d0da394e859dfd24021e0c365b1db058d5f6d0d4
--- /dev/null
+++ b/chrome/browser/ui/webui/vast/vast.mojom
@@ -0,0 +1,24 @@
+// Copyright 2026 The Vast Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+module vast.mojom;
+
+// Runtime facts supplied by the native browser process.
+struct RuntimeInfo {
+  string product_name;
+  string product_version;
+  string chromium_version;
+  string architecture;
+  bool electron_runtime_absent;
+};
+
+// Renderer-to-browser operations for chrome://vast.
+interface PageHandler {
+  GetRuntimeInfo() => (RuntimeInfo info);
+};
+
+// Creates the page-scoped native handler.
+interface PageHandlerFactory {
+  CreatePageHandler(pending_receiver<PageHandler> receiver);
+};
