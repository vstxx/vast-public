-  source->AddBoolean("electronRuntimeAbsent", true);
   webui::SetupWebUIDataSource(source, kVastResources, IDR_VAST_INDEX_HTML);
 }
 
 VastUI::~VastUI() = default;
 
+void VastUI::BindInterface(
+    mojo::PendingReceiver<mojom::PageHandlerFactory> receiver) {
+  factory_receiver_.reset();
+  factory_receiver_.Bind(std::move(receiver));
+}
+
+void VastUI::CreatePageHandler(
+    mojo::PendingReceiver<mojom::PageHandler> receiver) {
+  page_handler_receiver_.reset();
+  page_handler_receiver_.Bind(std::move(receiver));
+}
+
+void VastUI::GetRuntimeInfo(GetRuntimeInfoCallback callback) {
+  auto info = mojom::RuntimeInfo::New();
+  info->product_name = "Vast";
+  info->product_version = "2.0.0-dev";
+  info->chromium_version = version_info::GetVersionNumber();
+  info->architecture = "Upstream Chromium //chrome";
+  info->electron_runtime_absent = true;
+  std::move(callback).Run(std::move(info));
+}
+
+WEB_UI_CONTROLLER_TYPE_IMPL(VastUI)
+
 }  // namespace vast
