   return preview;
 }
 
+VastDataMigrationPreview ReadVastDataMigrationPreviewFromConfigRoot(
+    const base::FilePath& config_root) {
+  const base::FilePath config_path =
+      config_root.Append(FILE_PATH_LITERAL("data-root.json"));
+  if (!base::PathExists(config_path)) {
+    return ReadVastDataMigrationPreview(config_root);
+  }
+
+  VastDataMigrationPreview preview;
+  const std::optional<int64_t> config_size = base::GetFileSize(config_path);
+  if (!config_size || *config_size < 0 ||
+      *config_size > static_cast<int64_t>(kMaxDataRootConfigBytes)) {
+    preview.error = "data-root.json is unavailable or too large.";
+    return preview;
+  }
+
+  std::string contents;
+  if (!base::ReadFileToStringWithMaxSize(config_path, &contents,
+                                         kMaxDataRootConfigBytes)) {
+    preview.error = "data-root.json could not be read safely.";
+    return preview;
+  }
+  std::optional<base::DictValue> root =
+      base::JSONReader::ReadDict(contents, base::JSON_PARSE_RFC, 20);
+  if (!root) {
+    preview.error = "data-root.json is not valid JSON.";
+    return preview;
+  }
+
+  const std::string* configured = root->FindString("customDataRoot");
+  if (!configured) {
+    preview.error = "data-root.json does not contain customDataRoot.";
+    return preview;
+  }
+  const std::string_view trimmed =
+      base::TrimWhitespaceASCII(*configured, base::TRIM_ALL);
+  const base::FilePath configured_root =
+      base::FilePath::FromUTF8Unsafe(trimmed);
+  if (trimmed.empty() || !configured_root.IsAbsolute()) {
+    preview.error = "data-root.json must contain an absolute customDataRoot.";
+    return preview;
+  }
+  return ReadVastDataMigrationPreview(configured_root);
+}
+
 }  // namespace vast
