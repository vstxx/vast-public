 #include "base/values.h"
 
 namespace vast {
 namespace {
 
 constexpr size_t kMaxStorageBytes = 8 * 1024 * 1024;
+constexpr size_t kMaxDataRootConfigBytes = 64 * 1024;
 bool ReadCollectionCount(const base::DictValue& root,
                          std::string_view key,
                          size_t normalized_limit,
