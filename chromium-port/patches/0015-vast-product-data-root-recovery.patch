@@ -0,0 +1,181 @@
+// Copyright 2026 The Vast Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/vast/vast_product_data_root.h"
+
+#include <string>
+#include <string_view>
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/json/json_writer.h"
+#include "base/values.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace vast {
+namespace {
+
+constexpr char kValidVastData[] = R"({
+  "schemaVersion": 5,
+  "activeWorkspaceId": "workspace",
+  "workspaces": [
+    {"id":"workspace","name":"Workspace","icon":"home","color":"#123456","order":0}
+  ],
+  "tabGroups": [],
+  "tabs": [],
+  "bookmarks": [],
+  "bookmarkFolders": [],
+  "history": [],
+  "downloads": [],
+  "notes": [],
+  "readingList": [],
+  "quickLinks": [],
+  "settings": {"theme":"dark"}
+})";
+
+class VastProductDataRootTest : public testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(temp_dir_.CreateUniqueTempDir()); }
+
+  base::FilePath CreateDirectory(std::string_view name) {
+    const base::FilePath path = temp_dir_.GetPath().AppendASCII(name);
+    EXPECT_TRUE(base::CreateDirectory(path));
+    return path;
+  }
+
+  void Write(const base::FilePath& path, std::string_view contents) {
+    ASSERT_TRUE(base::CreateDirectory(path.DirName()));
+    ASSERT_TRUE(base::WriteFile(path, contents));
+  }
+
+  std::string Read(const base::FilePath& path) {
+    std::string contents;
+    EXPECT_TRUE(base::ReadFileToString(path, &contents));
+    return contents;
+  }
+
+  VastDataMigrationTransaction CommitFixture(const base::FilePath& source,
+                                             const base::FilePath& parent) {
+    Write(source.Append(FILE_PATH_LITERAL("vast-data.json")), kValidVastData);
+    Write(source.Append(FILE_PATH_LITERAL("password-vault.json")),
+          "opaque vault fixture");
+    VastDataMigrationTransaction transaction = PrepareVastDataMigration(
+        source, parent, parent.Append(FILE_PATH_LITERAL("Vast2Data")));
+    EXPECT_EQ(transaction.state, VastDataMigrationState::kPrepared)
+        << transaction.error;
+    EXPECT_TRUE(CommitVastDataMigration(&transaction)) << transaction.error;
+    return transaction;
+  }
+
+  base::FilePath SelectionPath(const base::FilePath& profile) {
+    return profile.Append(
+        FILE_PATH_LITERAL("VastProductData/root-selection.json"));
+  }
+
+  base::ScopedTempDir temp_dir_;
+};
+
+TEST_F(VastProductDataRootTest,
+       PersistsRecoversRollsBackAndClearsWithoutChangingSource) {
+  const base::FilePath source = CreateDirectory("Source");
+  const base::FilePath transactions = CreateDirectory("Transactions");
+  const base::FilePath profile = CreateDirectory("Profile");
+  VastDataMigrationTransaction transaction =
+      CommitFixture(source, transactions);
+  const std::string source_before =
+      Read(source.Append(FILE_PATH_LITERAL("vast-data.json")));
+
+  std::string error;
+  ASSERT_TRUE(ActivateVastProductDataRoot(profile, transaction, &error))
+      << error;
+  EXPECT_TRUE(base::PathExists(SelectionPath(profile)));
+
+  // A fresh call models a new browser-process instance after restart.
+  VastProductDataRootStatus recovered = RecoverVastProductDataRoot(profile);
+  ASSERT_TRUE(recovered.selected);
+  ASSERT_TRUE(recovered.compatible) << recovered.error;
+  EXPECT_EQ(recovered.schema_version, 5);
+  EXPECT_EQ(recovered.data_root, transaction.destination_root);
+  EXPECT_EQ(recovered.transaction.state, VastDataMigrationState::kCommitted);
+
+  ASSERT_TRUE(RollbackVastDataMigration(&recovered.transaction))
+      << recovered.transaction.error;
+  ASSERT_TRUE(DeactivateVastProductDataRoot(
+      profile, transaction.destination_root, transaction.journal_path, &error))
+      << error;
+  EXPECT_FALSE(base::PathExists(SelectionPath(profile)));
+  EXPECT_FALSE(base::PathExists(transaction.destination_root));
+  EXPECT_TRUE(base::PathExists(transaction.transaction_root.Append(
+      FILE_PATH_LITERAL("rolled-back-data/vast-data.json"))));
+  EXPECT_EQ(Read(source.Append(FILE_PATH_LITERAL("vast-data.json"))),
+            source_before);
+
+  const VastProductDataRootStatus after_clear =
+      RecoverVastProductDataRoot(profile);
+  EXPECT_FALSE(after_clear.selected);
+  EXPECT_TRUE(after_clear.error.empty());
+}
+
+TEST_F(VastProductDataRootTest, RejectsUncommittedTransaction) {
+  const base::FilePath source = CreateDirectory("Source");
+  const base::FilePath transactions = CreateDirectory("Transactions");
+  const base::FilePath profile = CreateDirectory("Profile");
+  Write(source.Append(FILE_PATH_LITERAL("vast-data.json")), kValidVastData);
+  VastDataMigrationTransaction transaction = PrepareVastDataMigration(
+      source, transactions,
+      transactions.Append(FILE_PATH_LITERAL("Vast2Data")));
+  ASSERT_EQ(transaction.state, VastDataMigrationState::kPrepared)
+      << transaction.error;
+
+  std::string error;
+  EXPECT_FALSE(ActivateVastProductDataRoot(profile, transaction, &error));
+  EXPECT_EQ(error,
+            "Only a committed migration can select a Vast product root.");
+  EXPECT_FALSE(base::PathExists(SelectionPath(profile)));
+}
+
+TEST_F(VastProductDataRootTest, RejectsDestinationChangedAfterActivation) {
+  const base::FilePath source = CreateDirectory("Source");
+  const base::FilePath transactions = CreateDirectory("Transactions");
+  const base::FilePath profile = CreateDirectory("Profile");
+  VastDataMigrationTransaction transaction =
+      CommitFixture(source, transactions);
+  std::string error;
+  ASSERT_TRUE(ActivateVastProductDataRoot(profile, transaction, &error))
+      << error;
+  Write(
+      transaction.destination_root.Append(FILE_PATH_LITERAL("vast-data.json")),
+      "tampered after activation");
+
+  const VastProductDataRootStatus recovered =
+      RecoverVastProductDataRoot(profile);
+
+  EXPECT_TRUE(recovered.selected);
+  EXPECT_FALSE(recovered.compatible);
+  EXPECT_EQ(recovered.error,
+            "Recovered Vast product data has an unexpected file size.");
+}
+
+TEST_F(VastProductDataRootTest, RejectsRelativeSelectionPaths) {
+  const base::FilePath profile = CreateDirectory("Profile");
+  base::DictValue selection;
+  selection.Set("formatVersion", 1);
+  selection.Set("state", "active");
+  selection.Set("dataRoot", "relative-data");
+  selection.Set("journalPath", "relative-journal.json");
+  std::string serialized;
+  ASSERT_TRUE(base::JSONWriter::Write(selection, &serialized));
+  Write(SelectionPath(profile), serialized);
+
+  const VastProductDataRootStatus recovered =
+      RecoverVastProductDataRoot(profile);
+
+  EXPECT_TRUE(recovered.selected);
+  EXPECT_FALSE(recovered.compatible);
+  EXPECT_EQ(recovered.error,
+            "Vast product-root selection paths must be absolute.");
+}
