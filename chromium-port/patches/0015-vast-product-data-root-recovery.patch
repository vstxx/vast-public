+// Copyright 2026 The Vast Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_VAST_VAST_PRODUCT_DATA_ROOT_H_
+#define CHROME_BROWSER_VAST_VAST_PRODUCT_DATA_ROOT_H_
+
+#include <cstdint>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "chrome/browser/vast/vast_data_migration_transaction.h"
+
+namespace vast {
+
+// Native-only recovery result. Paths and transaction metadata must never be
+// exposed to a renderer.
+struct VastProductDataRootStatus {
+  bool selected = false;
+  bool compatible = false;
+  int32_t schema_version = -1;
+  base::FilePath data_root;
+  VastDataMigrationTransaction transaction;
+  std::string error;
+};
+
+// Persists a committed, fully verified migration root below profile_path. The
+// selected product data can remain outside the Chromium profile, but no path is
+// accepted unless it is backed by the transaction journal and safety backup.
+bool ActivateVastProductDataRoot(
+    const base::FilePath& profile_path,
+    const VastDataMigrationTransaction& transaction,
+    std::string* error);
+
+// Recovers and re-verifies the selected root and committed transaction after a
+// browser restart. Absence of a selection is not an error.
+VastProductDataRootStatus RecoverVastProductDataRoot(
+    const base::FilePath& profile_path);
+
+// Removes only the small profile-local selection record after a successful
+// rollback. Product data and safety backups are never deleted here.
+bool DeactivateVastProductDataRoot(const base::FilePath& profile_path,
+                                   const base::FilePath& expected_data_root,
+                                   const base::FilePath& expected_journal_path,
+                                   std::string* error);
+
+}  // namespace vast
+
+#endif  // CHROME_BROWSER_VAST_VAST_PRODUCT_DATA_ROOT_H_
