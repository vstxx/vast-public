+
+#ifndef CHROME_BROWSER_UI_VIEWS_TOOLBAR_VAST_WORKSPACE_BUTTON_H_
+#define CHROME_BROWSER_UI_VIEWS_TOOLBAR_VAST_WORKSPACE_BUTTON_H_
+
+#include "base/callback_list.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ui/views/toolbar/toolbar_chip_button.h"
+
+class Browser;
+
+namespace ui {
+class Event;
+}
+
+namespace vast {
+class VastProductDataService;
+struct VastProductDataRootStatus;
+}  // namespace vast
+
+// Persistent native entry point for Vast-owned browser UI. Product data is
+// read only in the browser process through the profile-keyed service.
+class VastWorkspaceButton : public ToolbarChipButton {
+  METADATA_HEADER(VastWorkspaceButton, ToolbarChipButton)
+
+ public:
+  DECLARE_CLASS_ELEMENT_IDENTIFIER_VALUE(kElementId);
+
+  explicit VastWorkspaceButton(Browser* browser);
+  VastWorkspaceButton(const VastWorkspaceButton&) = delete;
+  VastWorkspaceButton& operator=(const VastWorkspaceButton&) = delete;
+  ~VastWorkspaceButton() override;
+
+ private:
+  void OnPressed(const ui::Event& event);
+  void RefreshStatus();
+  void OnInitialStatus(vast::VastProductDataRootStatus status);
+  void OnStatusChanged(const vast::VastProductDataRootStatus& status);
+  void ApplyDefaultState(bool needs_attention);
+
+  const raw_ptr<Browser> browser_;
+  const raw_ptr<vast::VastProductDataService> product_data_service_;
+  base::CallbackListSubscription status_changed_subscription_;
+  base::WeakPtrFactory<VastWorkspaceButton> weak_ptr_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TOOLBAR_VAST_WORKSPACE_BUTTON_H_
