@@ -0,0 +1,121 @@
+// Copyright 2026 The Vast Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/toolbar/vast_workspace_button.h"
+
+#include <algorithm>
+#include <string>
+
+#include "base/functional/bind.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/app/vector_icons/vector_icons.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/navigator/browser_navigator.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "chrome/browser/vast/vast_product_data_service.h"
+#include "chrome/browser/vast/vast_product_data_service_factory.h"
+#include "chrome/common/webui_url_constants.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/base/window_open_disposition_utils.h"
+#include "ui/events/event.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/gfx/text_constants.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/view_class_properties.h"
+
+namespace {
+
+constexpr int kMaximumButtonWidth = 180;
+
+}  // namespace
+
+DEFINE_CLASS_ELEMENT_IDENTIFIER_VALUE(VastWorkspaceButton, kElementId);
+
+VastWorkspaceButton::VastWorkspaceButton(Browser* browser)
+    : ToolbarChipButton(base::BindRepeating(&VastWorkspaceButton::OnPressed,
+                                            base::Unretained(this))),
+      browser_(browser),
+      product_data_service_(vast::VastProductDataServiceFactory::GetForProfile(
+          browser->profile())) {
+  CHECK(browser_);
+  CHECK(product_data_service_);
+  CHECK(browser_->profile()->IsRegularProfile());
+
+  SetProperty(views::kElementIdentifierKey, kElementId);
+  SetVectorIcon(kVastWorkspaceIcon);
+  SetMaxSize(gfx::Size(kMaximumButtonWidth, 0));
+  label()->SetElideBehavior(gfx::ELIDE_TAIL);
+  SetTriggerableEventFlags(ui::EF_LEFT_MOUSE_BUTTON |
+                           ui::EF_MIDDLE_MOUSE_BUTTON);
+  ApplyDefaultState(/*needs_attention=*/false);
+
+  status_changed_subscription_ =
+      product_data_service_->AddStatusChangedCallback(
+          base::BindRepeating(&VastWorkspaceButton::OnStatusChanged,
+                              weak_ptr_factory_.GetWeakPtr()));
+  RefreshStatus();
+}
+
+VastWorkspaceButton::~VastWorkspaceButton() = default;
+
+void VastWorkspaceButton::OnPressed(const ui::Event& event) {
+  NavigateParams params(browser_, GURL(chrome::kChromeUIVastURL),
+                        ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+  params.disposition = ui::DispositionFromEventFlags(event.flags());
+  Navigate(&params);
+}
+
+void VastWorkspaceButton::RefreshStatus() {
+  product_data_service_->GetStatus(base::BindOnce(
+      &VastWorkspaceButton::OnInitialStatus, weak_ptr_factory_.GetWeakPtr()));
+}
+
+void VastWorkspaceButton::OnInitialStatus(
+    vast::VastProductDataRootStatus status) {
+  OnStatusChanged(status);
+}
+
+void VastWorkspaceButton::OnStatusChanged(
+    const vast::VastProductDataRootStatus& status) {
+  if (!status.selected || !status.compatible || !status.projection.compatible) {
+    ApplyDefaultState(status.selected && !status.compatible);
+    return;
+  }
+
+  const auto active_workspace =
+      std::ranges::find_if(status.projection.workspaces,
+                           [](const vast::VastWorkspaceProjection& workspace) {
+                             return workspace.active;
+                           });
+  if (active_workspace == status.projection.workspaces.end()) {
+    ApplyDefaultState(/*needs_attention=*/true);
+    return;
+  }
+
+  const std::u16string workspace_name =
+      base::UTF8ToUTF16(active_workspace->name);
+  SetText(workspace_name);
+  const std::u16string prefix = active_workspace->is_private
+                                    ? u"Private Vast workspace: "
+                                    : u"Vast workspace: ";
+  const std::u16string description = prefix + workspace_name;
+  SetTooltipText(description);
+  GetViewAccessibility().SetName(description);
+  PreferredSizeChanged();
+}
+
+void VastWorkspaceButton::ApplyDefaultState(bool needs_attention) {
+  SetText(u"Vast");
+  const std::u16string description =
+      needs_attention ? u"Open Vast - workspace data needs attention"
+                      : u"Open Vast workspace hub";
+  SetTooltipText(description);
+  GetViewAccessibility().SetName(description);
+  PreferredSizeChanged();
+}
+
+BEGIN_METADATA(VastWorkspaceButton)
+END_METADATA
