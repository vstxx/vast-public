+// Copyright 2026 The Vast Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/vast/vast_backup_extractor.h"
+
+#include <map>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/json/json_writer.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/values.h"
+#include "chrome/browser/vast/vast_data_migration_transaction.h"
+#include "crypto/hash.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/zlib/google/zip.h"
+
+namespace vast {
+namespace {
+
+constexpr char kValidVastData[] = R"({
+  "schemaVersion": 5,
+  "activeWorkspaceId": "workspace-fixture",
+  "workspaces": [{"id":"workspace-fixture"}],
+  "tabGroups": [],
+  "tabs": [{"id":"tab-fixture","url":"https://example.test"}],
+  "bookmarks": [],
+  "bookmarkFolders": [],
+  "history": [],
+  "downloads": [],
+  "notes": [],
+  "readingList": [],
+  "quickLinks": [],
+  "settings": {}
+})";
+
+std::string Sha256(std::string_view contents) {
+  return base::ToLowerASCII(base::HexEncode(crypto::hash::Sha256(contents)));
+}
+
+class VastBackupExtractorTest : public testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(temp_dir_.CreateUniqueTempDir()); }
+
+  base::FilePath CreateDirectory(std::string_view name) {
+    const base::FilePath path = temp_dir_.GetPath().AppendASCII(name);
+    EXPECT_TRUE(base::CreateDirectory(path));
+    return path;
+  }
+
+  void Write(const base::FilePath& path, std::string_view contents) {
+    ASSERT_TRUE(base::CreateDirectory(path.DirName()));
+    ASSERT_TRUE(base::WriteFile(path, contents));
+  }
+
+  std::string Read(const base::FilePath& path) {
+    std::string contents;
+    EXPECT_TRUE(base::ReadFileToString(path, &contents));
+    return contents;
+  }
+
+  base::FilePath CreateBackup(
+      const std::map<std::string, std::string>& data_files,
+      const std::map<std::string, std::string>& extra_files = {},
+      std::string_view tamper_after_manifest = {}) {
+    const base::FilePath input = CreateDirectory("ArchiveInput");
+    const base::FilePath archive =
+        temp_dir_.GetPath().Append(FILE_PATH_LITERAL("fixture.vastbackup"));
+
+    base::DictValue checksums;
+    std::vector<base::FilePath> archive_paths;
+    for (const auto& [relative_path, contents] : data_files) {
+      const std::string archive_path = "data/" + relative_path;
+      base::DictValue checksum;
+      checksum.Set("sha256", Sha256(contents));
+      checksum.Set("sizeBytes", static_cast<int>(contents.size()));
+      checksums.Set(archive_path, std::move(checksum));
+      const base::FilePath relative_file =
+          base::FilePath::FromUTF8Unsafe(archive_path)
+              .NormalizePathSeparators();
+      Write(input.Append(relative_file), contents);
+      archive_paths.push_back(relative_file);
+    }
+
+    base::DictValue manifest;
+    manifest.Set("product", "Vast");
+    manifest.Set("appId", "app.vast.browser");
+    manifest.Set("exportFormatVersion", 1);
+    manifest.Set("appVersion", "1.0.11");
+    manifest.Set("platform", "win32");
+    manifest.Set("createdAt", "2026-07-16T00:00:00.000Z");
+    base::ListValue included_sections;
+    included_sections.Append("Vast profile JSON");
+    manifest.Set("includedSections", std::move(included_sections));
+    manifest.Set("excludedSections", base::ListValue());
+    manifest.Set("includedFileCount", static_cast<int>(data_files.size()));
+    manifest.Set("skippedFileCount", 0);
+    manifest.Set("skippedFiles", base::ListValue());
+    manifest.Set("vastDataIncluded", data_files.contains("vast-data.json"));
+    manifest.Set("passwordVaultIncluded",
+                 data_files.contains("password-vault.json"));
+    manifest.Set("checksums", std::move(checksums));
+    manifest.Set("warnings", base::ListValue());
+    std::string serialized_manifest;
+    EXPECT_TRUE(base::JSONWriter::WriteWithOptions(
+        manifest, base::JSONWriter::OPTIONS_PRETTY_PRINT,
+        &serialized_manifest));
+    serialized_manifest.push_back('\n');
+    Write(input.Append(FILE_PATH_LITERAL("manifest.json")),
+          serialized_manifest);
+    Write(input.Append(FILE_PATH_LITERAL("README.md")), "Vast Backup\n");
+    archive_paths.push_back(base::FilePath(FILE_PATH_LITERAL("manifest.json")));
+    archive_paths.push_back(base::FilePath(FILE_PATH_LITERAL("README.md")));
+
+    for (const auto& [relative_path, contents] : extra_files) {
+      const base::FilePath relative_file =
+          base::FilePath::FromUTF8Unsafe(relative_path)
+              .NormalizePathSeparators();
+      Write(input.Append(relative_file), contents);
+      archive_paths.push_back(relative_file);
+    }
+    if (!tamper_after_manifest.empty()) {
+      const std::string relative_data_path = std::string(
+          tamper_after_manifest.substr(std::string_view("data/").size()));
+      const auto original = data_files.find(relative_data_path);
+      if (original == data_files.end()) {
+        ADD_FAILURE() << "Tamper target is absent from the manifest fixture.";
+        return base::FilePath();
+      }
+      Write(input.Append(base::FilePath::FromUTF8Unsafe(tamper_after_manifest)
+                             .NormalizePathSeparators()),
+            std::string(original->second.size(), 'x'));
+    }
+
+    zip::ZipParams params;
+    params.src_dir = input;
+    params.dest_file = archive;
+    params.src_files = archive_paths;
+    EXPECT_TRUE(zip::Zip(params));
+    return archive;
+  }
+
+  base::ScopedTempDir temp_dir_;
+};
+
+TEST_F(VastBackupExtractorTest,
+       VerifiesAllFilesExtractsOnlyProductDataAndFeedsTransaction) {
+  const base::FilePath archive = CreateBackup({
+      {"vast-data.json", kValidVastData},
+      {"password-vault.json", "opaque encrypted vault fixture"},
+      {"Cookies", "verified but never extracted"},
+  });
+  const base::FilePath extraction_parent = CreateDirectory("Extractions");
+
+  VastBackupExtractionResult extraction =
+      ExtractVastBackupProductData(archive, extraction_parent);
+
+  ASSERT_TRUE(extraction.success) << extraction.error;
+  EXPECT_EQ(extraction.verified_files, 3u);
+  EXPECT_EQ(extraction.extracted_product_files, 2u);
+  EXPECT_TRUE(extraction.password_vault_present);
+  EXPECT_EQ(Read(extraction.product_data_root.Append(
+                FILE_PATH_LITERAL("vast-data.json"))),
+            kValidVastData);
+  EXPECT_EQ(Read(extraction.product_data_root.Append(
+                FILE_PATH_LITERAL("password-vault.json"))),
+            "opaque encrypted vault fixture");
+  EXPECT_FALSE(base::PathExists(
+      extraction.product_data_root.Append(FILE_PATH_LITERAL("Cookies"))));
+
+  const base::FilePath transactions = CreateDirectory("Transactions");
+  const base::FilePath destination =
+      transactions.Append(FILE_PATH_LITERAL("ImportedData"));
+  VastDataMigrationTransaction transaction = PrepareVastDataMigration(
+      extraction.product_data_root, transactions, destination);
+  ASSERT_EQ(transaction.state, VastDataMigrationState::kPrepared)
+      << transaction.error;
+  ASSERT_TRUE(CommitVastDataMigration(&transaction)) << transaction.error;
+  EXPECT_TRUE(base::PathExists(
+      destination.Append(FILE_PATH_LITERAL("vast-data.json"))));
+  ASSERT_TRUE(RollbackVastDataMigration(&transaction)) << transaction.error;
+  EXPECT_FALSE(base::PathExists(destination));
+}
+
+TEST_F(VastBackupExtractorTest, RejectsChecksumMismatchWithoutActivatingData) {
+  const base::FilePath archive = CreateBackup(
+      {{"vast-data.json", kValidVastData}}, {}, "data/vast-data.json");
+  const base::FilePath extraction_parent = CreateDirectory("Extractions");
+
+  VastBackupExtractionResult extraction =
+      ExtractVastBackupProductData(archive, extraction_parent);
+
+  EXPECT_FALSE(extraction.success);
+  EXPECT_EQ(extraction.error,
+            "Vast backup checksum or extraction verification failed.");
+  EXPECT_TRUE(extraction.work_root.empty());
+  EXPECT_TRUE(extraction.product_data_root.empty());
+}
+
+TEST_F(VastBackupExtractorTest, RejectsFilesAbsentFromManifest) {
+  const base::FilePath archive = CreateBackup(
+      {{"vast-data.json", kValidVastData}}, {{"unexpected.txt", "nope"}});
+
+  VastBackupExtractionResult extraction =
+      ExtractVastBackupProductData(archive, CreateDirectory("Extractions"));
+
+  EXPECT_FALSE(extraction.success);
+  EXPECT_EQ(extraction.error,
+            "Vast backup contains a file absent from its manifest.");
+}
+
+TEST_F(VastBackupExtractorTest, RejectsZipSlipBeforeExtraction) {
+  const base::FilePath archive = CreateBackup(
+      {{"vast-data.json", kValidVastData}}, {{"aa/escape", "nope"}});
+  std::string archive_contents = Read(archive);
+  base::ReplaceSubstringsAfterOffset(&archive_contents, 0, "aa/escape",
+                                     "../escape");
+  Write(archive, archive_contents);
+
+  VastBackupExtractionResult extraction =
+      ExtractVastBackupProductData(archive, CreateDirectory("Extractions"));
+
+  EXPECT_FALSE(extraction.success);
+  EXPECT_EQ(extraction.error, "Vast backup contains an unsafe archive path.");
+  EXPECT_TRUE(extraction.work_root.empty());
+}
+
+}  // namespace
+}  // namespace vast
