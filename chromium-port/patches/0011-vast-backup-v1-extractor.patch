+bool IsVastProductDataRelativePath(const base::FilePath& relative_path) {
+  if (relative_path.empty() || relative_path.IsAbsolute() ||
+      relative_path.ReferencesParent()) {
+    return false;
+  }
+  for (std::string_view name : kAllowlistedFiles) {
+    if (relative_path == base::FilePath::FromASCII(name)) {
+      return true;
+    }
+  }
+  for (std::string_view name : kAllowlistedDirectories) {
+    const base::FilePath directory = base::FilePath::FromASCII(name);
+    if (directory.IsParent(relative_path)) {
+      return true;
+    }
+  }
+  return false;
+}
