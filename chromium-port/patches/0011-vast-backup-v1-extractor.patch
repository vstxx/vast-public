+class VerifyingWriter final : public zip::WriterDelegate {
+ public:
+  VerifyingWriter(base::FilePath output_path,
+                  bool write_output,
+                  const ExpectedFile& expected,
+                  uint64_t* total_bytes)
+      : output_path_(std::move(output_path)),
+        write_output_(write_output),
+        expected_(expected),
+        total_bytes_(total_bytes),
+        hasher_(crypto::hash::kSha256) {}
+
+  bool PrepareOutput() override {
+    if (!write_output_) {
+      return true;
+    }
+    if (!base::CreateDirectory(output_path_.DirName())) {
+      return false;
+    }
+    file_ = base::File(output_path_,
+                       base::File::FLAG_CREATE_ALWAYS | base::File::FLAG_WRITE);
+    return file_.IsValid();
+  }
+
+  bool WriteBytes(base::span<const uint8_t> data) override {
+    if (bytes_written_ > expected_.size ||
+        data.size() > expected_.size - bytes_written_ ||
+        *total_bytes_ > kMaxTotalUncompressedBytes ||
+        data.size() > kMaxTotalUncompressedBytes - *total_bytes_) {
+      return false;
+    }
+    bytes_written_ += data.size();
+    *total_bytes_ += data.size();
+    hasher_.Update(data);
+    return !write_output_ || file_.WriteAtCurrentPosAndCheck(data);
+  }
+
+  void OnError() override {
+    file_.Close();
+    if (write_output_) {
+      base::DeleteFile(output_path_);
+    }
+  }
+
+  bool Finish() {
+    if (bytes_written_ != expected_.size) {
+      return false;
+    }
+    std::array<uint8_t, crypto::hash::kSha256Size> digest;
+    hasher_.Finish(digest);
+    return base::ToLowerASCII(base::HexEncode(digest)) == expected_.sha256;
+  }
+
+ private:
+  const base::FilePath output_path_;
+  const bool write_output_;
+  const ExpectedFile expected_;
+  raw_ptr<uint64_t> total_bytes_;
+  crypto::hash::Hasher hasher_;
+  base::File file_;
+  uint64_t bytes_written_ = 0;
+};
+
+base::FilePath ProductRelativePath(std::string_view archive_path) {
+  constexpr std::string_view kDataPrefix = "data/";
+  return base::FilePath::FromUTF8Unsafe(archive_path.substr(kDataPrefix.size()))
+      .NormalizePathSeparators();
+}
+
+bool ExtractAndVerifyFiles(std::string* archive,
+                           const BackupManifest& manifest,
+                           VastBackupExtractionResult* result) {
+  zip::ZipReader reader;
+  if (!reader.OpenFromString(*archive)) {
+    result->error = "Vast backup could not be reopened for verification.";
+    return false;
+  }
+  while (const zip::ZipReader::Entry* entry = reader.Next()) {
+    const std::optional<std::string> path =
+        NormalizeArchivePath(entry->path_in_original_encoding);
+    if (!path) {
+      result->error = "Vast backup contains an unsafe ZIP entry.";
+      return false;
+    }
+    const auto expected = manifest.files.find(*path);
+    if (expected == manifest.files.end()) {
+      continue;
+    }
+    const base::FilePath relative_path = ProductRelativePath(*path);
+    const bool extract_product = IsVastProductDataRelativePath(relative_path);
+    const base::FilePath output_path =
+        extract_product ? result->product_data_root.Append(relative_path)
+                        : base::FilePath();
+    VerifyingWriter writer(output_path, extract_product, expected->second,
+                           &result->verified_bytes);
+    if (entry->is_directory || entry->is_encrypted ||
+        !reader.ExtractCurrentEntry(&writer) || !writer.Finish()) {
+      result->error = "Vast backup checksum or extraction verification failed.";
+      return false;
+    }
+    ++result->verified_files;
+    if (extract_product) {
+      ++result->extracted_product_files;
+    }
+  }
+  if (!reader.ok() || result->verified_files != manifest.files.size()) {
+    result->error = "Vast backup ZIP verification did not complete.";
+    return false;
+  }
+  return true;
+}
