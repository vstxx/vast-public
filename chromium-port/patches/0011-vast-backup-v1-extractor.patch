+
+VastBackupExtractionResult ExtractVastBackupProductData(
+    const base::FilePath& archive_path,
+    const base::FilePath& extraction_parent) {
+  VastBackupExtractionResult result;
+  if (!archive_path.IsAbsolute() || !extraction_parent.IsAbsolute() ||
+      base::IsLink(archive_path)) {
+    result.error =
+        "Vast backup and extraction paths must be safe and absolute.";
+    return result;
+  }
+  const std::optional<int64_t> archive_size = base::GetFileSize(archive_path);
+  if (!archive_size || *archive_size < 0 ||
+      *archive_size > static_cast<int64_t>(kMaxArchiveBytes)) {
+    result.error = "Vast backup archive is unavailable or larger than 512 MiB.";
+    return result;
+  }
+  std::string archive;
+  if (!base::ReadFileToStringWithMaxSize(archive_path, &archive,
+                                         kMaxArchiveBytes) ||
+      archive.size() != static_cast<size_t>(*archive_size)) {
+    result.error = "Vast backup archive could not be read safely.";
+    return result;
+  }
+
+  const ArchiveMetadata metadata = ParseArchiveMetadata(archive);
+  if (!metadata.error.empty()) {
+    result.error = metadata.error;
+    return result;
+  }
+  std::optional<std::string> manifest_contents =
+      ExtractManifest(&archive, &result.error);
+  if (!manifest_contents) {
+    return result;
+  }
+  const BackupManifest manifest = ParseManifest(*manifest_contents);
+  if (!manifest.error.empty()) {
+    result.error = manifest.error;
+    return result;
+  }
+  if (!ValidateArchiveEntries(metadata, manifest, &result.error)) {
+    return result;
+  }
+
+  if (!base::CreateDirectory(extraction_parent) ||
+      !base::CreateTemporaryDirInDir(extraction_parent,
+                                     FILE_PATH_LITERAL(".vast-backup-extract-"),
+                                     &result.work_root)) {
+    result.error = "Vast backup extraction directory could not be created.";
+    return result;
+  }
+  result.product_data_root =
+      result.work_root.Append(FILE_PATH_LITERAL("product-data"));
+  if (!base::CreateDirectory(result.product_data_root) ||
+      !ExtractAndVerifyFiles(&archive, manifest, &result)) {
+    base::DeletePathRecursively(result.work_root);
+    result.work_root.clear();
+    result.product_data_root.clear();
+    return result;
+  }
+
+  const VastDataMigrationPreview preview =
+      ReadVastDataMigrationPreview(result.product_data_root);
+  if (!preview.compatible) {
+    result.error =
+        "Extracted Vast product data is incompatible: " + preview.error;
+    base::DeletePathRecursively(result.work_root);
+    result.work_root.clear();
+    result.product_data_root.clear();
+    return result;
+  }
+  result.password_vault_present = manifest.password_vault_present;
+  result.success = true;
+  return result;
+}
+
+}  // namespace vast
