+constexpr uint64_t kMaxArchiveBytes = 512 * 1024 * 1024;
+constexpr uint64_t kMaxEntryBytes = 256 * 1024 * 1024;
+constexpr uint64_t kMaxTotalUncompressedBytes = 2ULL * 1024 * 1024 * 1024;
+constexpr uint64_t kMaxManifestBytes = 16 * 1024 * 1024;
+constexpr size_t kMaxArchiveEntries = 10000;
+constexpr uint64_t kMaxCompressionRatio = 250;
+constexpr size_t kEndOfCentralDirectorySize = 22;
+constexpr size_t kMaxZipCommentBytes = 0xffff;
+
+constexpr uint32_t kLocalHeaderSignature = 0x04034b50;
+constexpr uint32_t kCentralHeaderSignature = 0x02014b50;
+constexpr uint32_t kEndOfCentralDirectorySignature = 0x06054b50;
+
+struct ArchiveEntryMetadata {
+  std::string path;
+  uint64_t compressed_size = 0;
+  uint64_t uncompressed_size = 0;
+};
+
+struct ArchiveMetadata {
+  std::vector<ArchiveEntryMetadata> entries;
+  std::string error;
+};
+
+struct ExpectedFile {
+  uint64_t size = 0;
+  std::string sha256;
+};
+
+struct BackupManifest {
+  std::map<std::string, ExpectedFile> files;
+  bool password_vault_present = false;
+  std::string error;
+};
+
+uint16_t ReadUint16(std::string_view bytes, size_t offset) {
+  return static_cast<uint16_t>(static_cast<uint8_t>(bytes[offset])) |
+         static_cast<uint16_t>(static_cast<uint8_t>(bytes[offset + 1])) << 8;
+}
+
+uint32_t ReadUint32(std::string_view bytes, size_t offset) {
+  return static_cast<uint32_t>(ReadUint16(bytes, offset)) |
+         static_cast<uint32_t>(ReadUint16(bytes, offset + 2)) << 16;
+}
+
+bool IsSafeArchiveComponent(std::string_view component) {
+  if (component.empty() || component == "." || component == ".." ||
+      component.size() > 255 || component.back() == '.' ||
+      component.back() == ' ') {
+    return false;
+  }
+  for (unsigned char character : component) {
+    if (character < 0x20 || std::string_view("<>:\"|?*").contains(character)) {
+      return false;
+    }
+  }
+  const size_t extension = component.find('.');
+  const std::string device_name = base::ToUpperASCII(component.substr(
+      0, extension == std::string_view::npos ? component.size() : extension));
+  if (device_name == "CON" || device_name == "PRN" || device_name == "AUX" ||
+      device_name == "NUL") {
+    return false;
+  }
+  if (device_name.size() == 4 &&
+      (device_name.starts_with("COM") || device_name.starts_with("LPT")) &&
+      device_name[3] >= '1' && device_name[3] <= '9') {
+    return false;
+  }
+  return true;
+}
+
+std::optional<std::string> NormalizeArchivePath(std::string_view raw_path) {
+  if (raw_path.empty() || !base::IsStringUTF8(raw_path) ||
+      raw_path.find('\0') != std::string_view::npos || raw_path.size() > 4096) {
+    return std::nullopt;
+  }
+  std::string path(raw_path);
+  base::ReplaceChars(path, "\\", "/", &path);
+  if (path.empty() || path.front() == '/' || path.back() == '/' ||
+      (path.size() >= 2 && base::IsAsciiAlpha(path[0]) && path[1] == ':')) {
+    return std::nullopt;
+  }
+  size_t component_start = 0;
+  while (component_start <= path.size()) {
+    const size_t separator = path.find('/', component_start);
+    const size_t component_end =
+        separator == std::string::npos ? path.size() : separator;
+    const std::string_view component = std::string_view(path).substr(
+        component_start, component_end - component_start);
+    if (!IsSafeArchiveComponent(component)) {
+      return std::nullopt;
+    }
+    if (separator == std::string::npos) {
+      break;
+    }
+    component_start = separator + 1;
+  }
+  return path;
+}
+
+bool IsKnownVolatileBackupEntry(std::string_view archive_path) {
+  constexpr std::array<std::string_view, 12> kVolatileDirectories = {
+      "cache",
+      "code cache",
+      "gpucache",
+      "dawncache",
+      "dawngraphitecache",
+      "dawnwebgpucache",
+      "shadercache",
+      "crashpad",
+      "crash reports",
+      "updaterdownloads",
+      "updaterlogs",
+      "temp",
+  };
+  if (!archive_path.starts_with("data/")) {
+    return false;
+  }
+  std::string relative =
+      base::ToLowerASCII(archive_path.substr(std::string_view("data/").size()));
+  size_t component_start = 0;
+  while (component_start <= relative.size()) {
+    const size_t separator = relative.find('/', component_start);
+    const size_t component_end =
+        separator == std::string::npos ? relative.size() : separator;
+    const std::string_view component = std::string_view(relative).substr(
+        component_start, component_end - component_start);
+    if (std::ranges::find(kVolatileDirectories, component) !=
+        kVolatileDirectories.end()) {
+      return true;
+    }
+    if (separator == std::string::npos) {
+      break;
+    }
+    component_start = separator + 1;
+  }
+  return relative == "tmp" || relative.starts_with("tmp/");
+}
+
+ArchiveMetadata ParseArchiveMetadata(std::string_view archive) {
+  ArchiveMetadata result;
+  if (archive.size() < kEndOfCentralDirectorySize ||
+      archive.size() > kMaxArchiveBytes) {
+    result.error = "Vast backup archive is invalid or too large.";
+    return result;
+  }
+
+  const size_t minimum_offset =
+      archive.size() > kMaxZipCommentBytes + kEndOfCentralDirectorySize
+          ? archive.size() - kMaxZipCommentBytes - kEndOfCentralDirectorySize
+          : 0;
+  std::optional<size_t> end_offset;
+  for (size_t offset = archive.size() - kEndOfCentralDirectorySize;; --offset) {
+    if (ReadUint32(archive, offset) == kEndOfCentralDirectorySignature &&
+        offset + kEndOfCentralDirectorySize +
+                ReadUint16(archive, offset + 20) ==
+            archive.size()) {
+      end_offset = offset;
+      break;
+    }
+    if (offset == minimum_offset) {
+      break;
+    }
+  }
+  if (!end_offset) {
+    result.error = "Vast backup end-of-central-directory record is missing.";
+    return result;
+  }
+  const size_t eocd = *end_offset;
+  const uint16_t comment_length = ReadUint16(archive, eocd + 20);
+  if (eocd + kEndOfCentralDirectorySize + comment_length != archive.size() ||
+      ReadUint16(archive, eocd + 4) != 0 ||
+      ReadUint16(archive, eocd + 6) != 0) {
+    result.error = "Vast backup has an unsupported ZIP envelope.";
+    return result;
+  }
+  const uint16_t disk_entries = ReadUint16(archive, eocd + 8);
+  const uint16_t total_entries = ReadUint16(archive, eocd + 10);
+  const uint32_t central_size = ReadUint32(archive, eocd + 12);
+  const uint32_t central_offset = ReadUint32(archive, eocd + 16);
+  if (disk_entries != total_entries || total_entries > kMaxArchiveEntries ||
+      static_cast<uint64_t>(central_offset) + central_size != eocd) {
+    result.error = "Vast backup central directory is invalid.";
+    return result;
+  }
+
+  std::set<std::string> paths;
+  uint64_t total_uncompressed = 0;
+  size_t cursor = central_offset;
+  for (size_t index = 0; index < total_entries; ++index) {
+    if (cursor > eocd || eocd - cursor < 46 ||
+        ReadUint32(archive, cursor) != kCentralHeaderSignature) {
+      result.error = "Vast backup central entry is invalid.";
+      return result;
+    }
+    const uint16_t flags = ReadUint16(archive, cursor + 8);
+    const uint16_t method = ReadUint16(archive, cursor + 10);
+    const uint32_t compressed_size = ReadUint32(archive, cursor + 20);
+    const uint32_t uncompressed_size = ReadUint32(archive, cursor + 24);
+    const uint16_t name_length = ReadUint16(archive, cursor + 28);
+    const uint16_t extra_length = ReadUint16(archive, cursor + 30);
+    const uint16_t entry_comment_length = ReadUint16(archive, cursor + 32);
+    const uint32_t local_offset = ReadUint32(archive, cursor + 42);
+    const uint64_t central_entry_size =
+        46ULL + name_length + extra_length + entry_comment_length;
+    if (central_entry_size > eocd - cursor || name_length == 0) {
+      result.error = "Vast backup central entry bounds are invalid.";
+      return result;
+    }
+    const std::string_view raw_path = archive.substr(cursor + 46, name_length);
+    const std::optional<std::string> normalized =
+        NormalizeArchivePath(raw_path);
+    if (!normalized) {
+      result.error = "Vast backup contains an unsafe archive path.";
+      return result;
+    }
+    const std::string comparison_path = base::ToLowerASCII(*normalized);
+    if (!paths.insert(comparison_path).second) {
+      result.error = "Vast backup contains a duplicate archive path.";
+      return result;
+    }
+    if ((flags & 0x0001) != 0 || (method != 0 && method != 8)) {
+      result.error = "Vast backup contains an encrypted or unsupported entry.";
+      return result;
+    }
+    if (uncompressed_size > kMaxEntryBytes ||
+        uncompressed_size > kMaxTotalUncompressedBytes - total_uncompressed) {
+      result.error = "Vast backup exceeds uncompressed data limits.";
+      return result;
+    }
+    total_uncompressed += uncompressed_size;
+    if (uncompressed_size > 1024 * 1024 &&
+        (compressed_size == 0 ||
+         uncompressed_size > compressed_size * kMaxCompressionRatio) &&
+        !IsKnownVolatileBackupEntry(*normalized)) {
+      result.error = "Vast backup entry has a suspicious compression ratio.";
+      return result;
+    }
+
+    if (local_offset > central_offset || central_offset - local_offset < 30 ||
+        ReadUint32(archive, local_offset) != kLocalHeaderSignature) {
+      result.error = "Vast backup local entry is invalid.";
+      return result;
+    }
+    const uint16_t local_flags = ReadUint16(archive, local_offset + 6);
+    const uint16_t local_method = ReadUint16(archive, local_offset + 8);
+    const uint32_t local_compressed_size =
+        ReadUint32(archive, local_offset + 18);
+    const uint32_t local_uncompressed_size =
+        ReadUint32(archive, local_offset + 22);
+    const uint16_t local_name_length = ReadUint16(archive, local_offset + 26);
+    const uint16_t local_extra_length = ReadUint16(archive, local_offset + 28);
+    const uint64_t data_start = static_cast<uint64_t>(local_offset) + 30 +
+                                local_name_length + local_extra_length;
+    if (data_start + compressed_size > central_offset ||
+        local_name_length != name_length || local_flags != flags ||
+        local_method != method || local_compressed_size != compressed_size ||
+        local_uncompressed_size != uncompressed_size ||
+        archive.substr(local_offset + 30, local_name_length) != raw_path) {
+      result.error = "Vast backup local and central entries do not match.";
+      return result;
+    }
+
+    result.entries.push_back({*normalized, compressed_size, uncompressed_size});
+    cursor += static_cast<size_t>(central_entry_size);
+  }
+  if (cursor != eocd) {
+    result.error = "Vast backup central directory size does not match.";
+  }
+  return result;
+}
+
+std::optional<std::string> ExtractManifest(std::string* archive,
+                                           std::string* error) {
+  zip::ZipReader reader;
+  if (!reader.OpenFromString(*archive)) {
+    *error = "Vast backup could not be opened as ZIP.";
+    return std::nullopt;
+  }
+  while (const zip::ZipReader::Entry* entry = reader.Next()) {
+    const std::optional<std::string> path =
+        NormalizeArchivePath(entry->path_in_original_encoding);
+    if (!path) {
+      *error = "Vast backup contains an unsafe ZIP entry.";
+      return std::nullopt;
+    }
+    if (*path == "manifest.json") {
+      std::string manifest;
+      if (entry->is_directory || entry->is_encrypted ||
+          !reader.ExtractCurrentEntryToString(kMaxManifestBytes, &manifest)) {
+        *error = "Vast backup manifest could not be read safely.";
+        return std::nullopt;
+      }
+      return manifest;
+    }
+  }
+  *error = reader.ok() ? "Vast backup manifest is missing."
+                       : "Vast backup ZIP enumeration failed.";
+  return std::nullopt;
+}
+
+bool IsValidSha256(std::string_view value) {
+  return value.size() == crypto::hash::kSha256Size * 2 &&
+         std::ranges::all_of(
+             value, [](char character) { return base::IsHexDigit(character); });
+}
+
+BackupManifest ParseManifest(std::string_view contents) {
+  BackupManifest manifest;
+  std::optional<base::DictValue> root =
+      base::JSONReader::ReadDict(contents, base::JSON_PARSE_RFC, 100);
+  if (!root) {
+    manifest.error = "Vast backup manifest is not valid JSON.";
+    return manifest;
+  }
+  const std::string* product = root->FindString("product");
+  const std::optional<int> format = root->FindInt("exportFormatVersion");
+  const base::ListValue* included_sections = root->FindList("includedSections");
+  const std::optional<int> included_file_count =
+      root->FindInt("includedFileCount");
+  const std::optional<bool> vast_data_included =
+      root->FindBool("vastDataIncluded");
+  const base::DictValue* checksums = root->FindDict("checksums");
+  if (!product || *product != "Vast" || !format || *format != 1 ||
+      !included_sections || !included_file_count || *included_file_count < 0 ||
+      !vast_data_included || !*vast_data_included || !checksums) {
+    manifest.error = "Vast backup manifest is incompatible or incomplete.";
+    return manifest;
+  }
+  if (static_cast<size_t>(*included_file_count) != checksums->size() ||
+      checksums->size() > kMaxArchiveEntries) {
+    manifest.error =
+        "Vast backup manifest file count does not match its checksums.";
+    return manifest;
+  }
+
+  for (auto checksum_entry : *checksums) {
+    const std::string& path = checksum_entry.first;
+    const base::Value& value = checksum_entry.second;
+    const std::optional<std::string> normalized = NormalizeArchivePath(path);
+    const base::DictValue* checksum = value.GetIfDict();
+    if (!normalized || *normalized != path ||
+        !normalized->starts_with("data/") || *normalized == "data/" ||
+        !checksum) {
+      manifest.error = "Vast backup manifest has an invalid checksum path.";
+      return manifest;
+    }
+    const std::string* sha256 = checksum->FindString("sha256");
+    const std::optional<int> size = checksum->FindInt("sizeBytes");
+    if (!sha256 || !IsValidSha256(*sha256) || !size || *size < 0 ||
+        static_cast<uint64_t>(*size) > kMaxEntryBytes) {
+      manifest.error = "Vast backup manifest has an invalid checksum.";
+      return manifest;
+    }
+    ExpectedFile expected;
+    expected.size = *size;
+    expected.sha256 = base::ToLowerASCII(*sha256);
+    if (!manifest.files.emplace(path, std::move(expected)).second) {
+      manifest.error = "Vast backup manifest has a duplicate checksum path.";
+      return manifest;
+    }
+  }
+  if (!manifest.files.contains("data/vast-data.json")) {
+    manifest.error = "Vast backup lacks the required Vast data file.";
+    return manifest;
+  }
+  manifest.password_vault_present =
+      manifest.files.contains("data/password-vault.json");
+  return manifest;
+}
+
+bool ValidateArchiveEntries(const ArchiveMetadata& metadata,
+                            const BackupManifest& manifest,
+                            std::string* error) {
+  std::set<std::string> observed;
+  for (const ArchiveEntryMetadata& entry : metadata.entries) {
+    observed.insert(entry.path);
+    if (entry.path == "manifest.json" || entry.path == "README.md") {
+      continue;
+    }
+    const auto expected = manifest.files.find(entry.path);
+    if (expected == manifest.files.end()) {
+      *error = "Vast backup contains a file absent from its manifest.";
+      return false;
+    }
+    if (entry.uncompressed_size != expected->second.size) {
+      *error = "Vast backup entry size differs from its manifest.";
+      return false;
+    }
+  }
+  for (const auto& [path, expected] : manifest.files) {
+    if (!observed.contains(path)) {
+      *error = "Vast backup is missing a checksummed file.";
+      return false;
+    }
+  }
+  return true;
+}
