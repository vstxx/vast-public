+// Copyright 2026 The Vast Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_VAST_VAST_BACKUP_EXTRACTOR_H_
+#define CHROME_BROWSER_VAST_VAST_BACKUP_EXTRACTOR_H_
+
+#include <cstdint>
+#include <string>
+
+#include "base/files/file_path.h"
+
+namespace vast {
+
+// Native-only result from verifying a .vastbackup v1 archive. The extracted
+// root contains only Vast-owned product data; all declared archive files are
+// still streamed and checksum-verified. Paths must not cross into WebUI.
+struct VastBackupExtractionResult {
+  bool success = false;
+  base::FilePath work_root;
+  base::FilePath product_data_root;
+  uint32_t verified_files = 0;
+  uint32_t extracted_product_files = 0;
+  uint64_t verified_bytes = 0;
+  bool password_vault_present = false;
+  std::string error;
+};
+
+// Validates the Electron 1.0.11 .vastbackup v1 envelope, manifest, entry
+// paths, bounded expansion, CRC (through ZipReader), declared sizes, and
+// SHA-256 checksums. On success, only allowlisted Vast product data is written
+// below a fresh temporary directory in extraction_parent. Browser cookies,
+// sessions, Local State, Preferences, and other profile artifacts are verified
+// but never extracted.
+VastBackupExtractionResult ExtractVastBackupProductData(
+    const base::FilePath& archive_path,
+    const base::FilePath& extraction_parent);
+
+}  // namespace vast
+
+#endif  // CHROME_BROWSER_VAST_VAST_BACKUP_EXTRACTOR_H_
