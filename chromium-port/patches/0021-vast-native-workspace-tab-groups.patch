+#ifndef CHROME_BROWSER_UI_VIEWS_TOOLBAR_VAST_WORKSPACE_TAB_CONTROLLER_H_
+#define CHROME_BROWSER_UI_VIEWS_TOOLBAR_VAST_WORKSPACE_TAB_CONTROLLER_H_
+
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/callback_list.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "chrome/browser/vast/vast_data_projection.h"
+#include "components/tab_groups/tab_group_color.h"
+#include "components/tab_groups/tab_group_id.h"
+
+class Browser;
+class TabStripModel;
+
+namespace tabs {
+class TabInterface;
+}
+
+namespace vast {
+class VastProductDataService;
+struct VastProductDataRootStatus;
+}  // namespace vast
+
+// Browser-window-scoped adapter from validated Vast workspace selection to
+// native Chromium tab groups. It never receives or persists URLs.
+class VastWorkspaceTabController : public TabStripModelObserver {
+ public:
+  VastWorkspaceTabController(
+      Browser* browser,
+      vast::VastProductDataService* product_data_service);
+  VastWorkspaceTabController(const VastWorkspaceTabController&) = delete;
+  VastWorkspaceTabController& operator=(const VastWorkspaceTabController&) =
+      delete;
+  ~VastWorkspaceTabController() override;
+
+ private:
+  void OnInitialStatus(vast::VastProductDataRootStatus status);
+  void OnStatusChanged(const vast::VastProductDataRootStatus& status);
+  void ApplyStatus(const vast::VastProductDataRootStatus& status);
+  void ReconcileRestoredGroups();
+  std::optional<tab_groups::TabGroupId> EnsureWorkspaceGroup(
+      const vast::VastWorkspaceProjection& workspace);
+  void UpdateGroupVisualsAndActivate(
+      const vast::VastWorkspaceProjection& active_workspace,
+      tab_groups::TabGroupId active_group);
+  void AssignInsertedTabs(
+      std::vector<base::WeakPtr<tabs::TabInterface>> inserted_tabs);
+  std::u16string WorkspaceGroupTitle(
+      const vast::VastWorkspaceProjection& workspace) const;
+  tab_groups::TabGroupColorId WorkspaceGroupColor(
+      const vast::VastWorkspaceProjection& workspace) const;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+  void OnTabGroupWillBeRemoved(const tab_groups::TabGroupId& group_id) override;
+
+  const raw_ptr<Browser> browser_;
+  const raw_ptr<TabStripModel> tab_strip_model_;
+  const raw_ptr<vast::VastProductDataService> product_data_service_;
+  std::vector<vast::VastWorkspaceProjection> workspaces_;
+  std::string active_workspace_id_;
+  std::map<std::string, tab_groups::TabGroupId> workspace_groups_;
+  std::map<std::string, base::WeakPtr<tabs::TabInterface>> last_active_tabs_;
+  bool applying_workspace_state_ = false;
+  base::CallbackListSubscription status_changed_subscription_;
+  base::WeakPtrFactory<VastWorkspaceTabController> weak_ptr_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TOOLBAR_VAST_WORKSPACE_TAB_CONTROLLER_H_
