+TEST_F(VastDataMigrationTransactionTest,
+       RejectsMalformedDataAfterCreatingSafetyBackup) {
+  const base::FilePath source = CreateDirectory("Source");
+  const base::FilePath transactions = CreateDirectory("Transactions");
+  const base::FilePath destination =
+      transactions.Append(FILE_PATH_LITERAL("Vast2Data"));
+  Write(source.Append(FILE_PATH_LITERAL("vast-data.json")),
+        "{\"schemaVersion\":");
+
+  VastDataMigrationTransaction transaction =
+      PrepareVastDataMigration(source, transactions, destination);
+
+  EXPECT_EQ(transaction.state, VastDataMigrationState::kFailed);
+  EXPECT_NE(transaction.error.find("safety backup is incompatible"),
+            std::string::npos);
+  EXPECT_TRUE(base::PathExists(transaction.safety_backup_root.Append(
+      FILE_PATH_LITERAL("vast-data.json"))));
+  EXPECT_TRUE(base::PathExists(transaction.journal_path));
+  EXPECT_FALSE(base::PathExists(destination));
+  EXPECT_EQ(Read(source.Append(FILE_PATH_LITERAL("vast-data.json"))),
+            "{\"schemaVersion\":");
+}
