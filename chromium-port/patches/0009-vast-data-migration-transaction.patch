+constexpr char kValidVastData[] = R"({
+  "schemaVersion": 5,
+  "activeWorkspaceId": "workspace-fixture",
+  "workspaces": [{"id":"workspace-fixture"}],
+  "tabGroups": [],
+  "tabs": [{"id":"tab-fixture","url":"https://example.test"}],
+  "bookmarks": [],
+  "bookmarkFolders": [],
+  "history": [],
+  "downloads": [],
+  "notes": [],
+  "readingList": [],
+  "quickLinks": [],
+  "settings": {}
+})";
+
+class VastDataMigrationTransactionTest : public testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(temp_dir_.CreateUniqueTempDir()); }
+
+  base::FilePath CreateDirectory(std::string_view name) {
+    const base::FilePath path = temp_dir_.GetPath().AppendASCII(name);
+    EXPECT_TRUE(base::CreateDirectory(path));
+    return path;
+  }
+
+  void Write(const base::FilePath& path, std::string_view contents) {
+    ASSERT_TRUE(base::CreateDirectory(path.DirName()));
+    ASSERT_TRUE(base::WriteFile(path, contents));
+  }
+
+  std::string Read(const base::FilePath& path) {
+    std::string contents;
+    EXPECT_TRUE(base::ReadFileToString(path, &contents));
+    return contents;
+  }
+
+  void WriteConfig(const base::FilePath& config_root,
+                   const base::FilePath& data_root) {
+    base::DictValue value;
+    value.Set("customDataRoot", data_root.AsUTF8Unsafe());
+    std::string serialized;
+    ASSERT_TRUE(base::JSONWriter::Write(value, &serialized));
+    Write(config_root.Append(FILE_PATH_LITERAL("data-root.json")), serialized);
+  }
+
+  base::ScopedTempDir temp_dir_;
+};
+
+TEST_F(VastDataMigrationTransactionTest,
+       PreparesCommitsAndRollsBackWithoutChangingSource) {
+  const base::FilePath source = CreateDirectory("Source");
+  const base::FilePath transactions = CreateDirectory("Transactions");
+  const base::FilePath destination =
+      transactions.Append(FILE_PATH_LITERAL("Vast2Data"));
+  Write(source.Append(FILE_PATH_LITERAL("vast-data.json")), kValidVastData);
+  Write(source.Append(FILE_PATH_LITERAL("password-vault.json")),
+        "opaque encrypted vault fixture");
+  Write(source.Append(FILE_PATH_LITERAL("storage-backups/previous.json")),
+        "storage backup fixture");
+  Write(source.Append(FILE_PATH_LITERAL("avidae/memory.json")),
+        "avidae fixture");
+  Write(source.Append(FILE_PATH_LITERAL("Cookies")), "must not migrate");
+  Write(source.Append(FILE_PATH_LITERAL("Local State")), "must not migrate");
+  Write(source.Append(FILE_PATH_LITERAL("Sessions/session")),
+        "must not migrate");
+  const std::string source_before =
+      Read(source.Append(FILE_PATH_LITERAL("vast-data.json")));
+
+  VastDataMigrationTransaction transaction =
+      PrepareVastDataMigration(source, transactions, destination);
+
+  ASSERT_EQ(transaction.state, VastDataMigrationState::kPrepared)
+      << transaction.error;
+  EXPECT_EQ(transaction.files.size(), 4u);
+  EXPECT_FALSE(transaction.transaction_root.empty());
+  EXPECT_TRUE(base::PathExists(transaction.journal_path));
+  EXPECT_EQ(Read(source.Append(FILE_PATH_LITERAL("vast-data.json"))),
+            source_before);
+  EXPECT_EQ(Read(transaction.safety_backup_root.Append(
+                FILE_PATH_LITERAL("password-vault.json"))),
+            "opaque encrypted vault fixture");
+  EXPECT_FALSE(base::PathExists(
+      transaction.safety_backup_root.Append(FILE_PATH_LITERAL("Cookies"))));
+  EXPECT_FALSE(base::PathExists(
+      transaction.staging_root.Append(FILE_PATH_LITERAL("Local State"))));
+  EXPECT_FALSE(base::PathExists(
+      transaction.staging_root.Append(FILE_PATH_LITERAL("Sessions"))));
+  EXPECT_NE(Read(transaction.journal_path).find("sha256"), std::string::npos);
+
+  ASSERT_TRUE(CommitVastDataMigration(&transaction)) << transaction.error;
+  EXPECT_EQ(transaction.state, VastDataMigrationState::kCommitted);
+  EXPECT_TRUE(base::PathExists(
+      destination.Append(FILE_PATH_LITERAL("vast-data.json"))));
+  EXPECT_FALSE(base::PathExists(transaction.staging_root));
+  EXPECT_TRUE(base::PathExists(transaction.safety_backup_root));
+  EXPECT_EQ(Read(source.Append(FILE_PATH_LITERAL("vast-data.json"))),
+            source_before);
+
+  ASSERT_TRUE(RollbackVastDataMigration(&transaction)) << transaction.error;
+  EXPECT_EQ(transaction.state, VastDataMigrationState::kRolledBack);
+  EXPECT_FALSE(base::PathExists(destination));
+  EXPECT_TRUE(base::PathExists(transaction.transaction_root.Append(
+      FILE_PATH_LITERAL("rolled-back-data/vast-data.json"))));
+  EXPECT_EQ(Read(source.Append(FILE_PATH_LITERAL("vast-data.json"))),
+            source_before);
+}
