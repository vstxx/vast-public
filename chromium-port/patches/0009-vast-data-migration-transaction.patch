+TEST_F(VastDataMigrationTransactionTest, ResolvesCustomRootBeforeCopying) {
+  const base::FilePath config = CreateDirectory("Config");
+  const base::FilePath source = CreateDirectory("CustomData");
+  const base::FilePath transactions = CreateDirectory("Transactions");
+  const base::FilePath destination =
+      transactions.Append(FILE_PATH_LITERAL("Vast2Data"));
+  Write(source.Append(FILE_PATH_LITERAL("vast-data.json")), kValidVastData);
+  WriteConfig(config, source);
+
+  VastDataMigrationTransaction transaction =
+      PrepareVastDataMigration(config, transactions, destination);
+
+  ASSERT_EQ(transaction.state, VastDataMigrationState::kPrepared)
+      << transaction.error;
+  EXPECT_EQ(transaction.source_root, base::MakeAbsoluteFilePath(source));
+  EXPECT_TRUE(base::PathExists(transaction.safety_backup_root.Append(
+      FILE_PATH_LITERAL("vast-data.json"))));
+}
+
+TEST_F(VastDataMigrationTransactionTest, RejectsExistingDestination) {
+  const base::FilePath source = CreateDirectory("Source");
+  const base::FilePath transactions = CreateDirectory("Transactions");
+  const base::FilePath destination =
+      transactions.Append(FILE_PATH_LITERAL("Existing"));
+  Write(source.Append(FILE_PATH_LITERAL("vast-data.json")), kValidVastData);
+  Write(destination.Append(FILE_PATH_LITERAL("keep.txt")), "keep");
+
+  VastDataMigrationTransaction transaction =
+      PrepareVastDataMigration(source, transactions, destination);
+
+  EXPECT_EQ(transaction.state, VastDataMigrationState::kFailed);
+  EXPECT_EQ(transaction.error, "The migration destination already exists.");
+  EXPECT_EQ(Read(destination.Append(FILE_PATH_LITERAL("keep.txt"))), "keep");
+  EXPECT_TRUE(transaction.transaction_root.empty());
+}
+
+TEST_F(VastDataMigrationTransactionTest, RejectsOverlappingPaths) {
+  const base::FilePath source = CreateDirectory("Source");
+  const base::FilePath transactions =
+      source.Append(FILE_PATH_LITERAL("Transactions"));
+  ASSERT_TRUE(base::CreateDirectory(transactions));
+  const base::FilePath destination =
+      transactions.Append(FILE_PATH_LITERAL("Vast2Data"));
+  Write(source.Append(FILE_PATH_LITERAL("vast-data.json")), kValidVastData);
+
+  VastDataMigrationTransaction transaction =
+      PrepareVastDataMigration(source, transactions, destination);
+
+  EXPECT_EQ(transaction.state, VastDataMigrationState::kFailed);
+  EXPECT_EQ(
+      transaction.error,
+      "Migration source, transaction, and destination paths must not overlap.");
+  EXPECT_FALSE(base::PathExists(destination));
+}
