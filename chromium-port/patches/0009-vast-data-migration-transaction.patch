@@ -0,0 +1,63 @@
+// Copyright 2026 The Vast Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_VAST_VAST_DATA_MIGRATION_TRANSACTION_H_
+#define CHROME_BROWSER_VAST_VAST_DATA_MIGRATION_TRANSACTION_H_
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+
+namespace vast {
+
+enum class VastDataMigrationState {
+  kFailed,
+  kPrepared,
+  kCommitted,
+  kRolledBack,
+};
+
+struct VastDataMigrationFile {
+  base::FilePath relative_path;
+  uint64_t size = 0;
+  std::string sha256;
+};
+
+// Native-only transaction state. Paths and checksums must not cross the WebUI
+// boundary because they may reveal local profile details.
+struct VastDataMigrationTransaction {
+  VastDataMigrationState state = VastDataMigrationState::kFailed;
+  base::FilePath source_root;
+  base::FilePath destination_root;
+  base::FilePath transaction_root;
+  base::FilePath safety_backup_root;
+  base::FilePath staging_root;
+  base::FilePath journal_path;
+  std::vector<VastDataMigrationFile> files;
+  uint64_t total_bytes = 0;
+  std::string error;
+};
+
+// Creates an isolated transaction directory below transaction_parent, copies
+// only allowlisted Vast-owned product data into a safety backup, validates that
+// copy, then creates and verifies a second staging copy. The source is never
+// modified. The destination must not exist.
+VastDataMigrationTransaction PrepareVastDataMigration(
+    const base::FilePath& source_config_root,
+    const base::FilePath& transaction_parent,
+    const base::FilePath& destination_root);
+
+// Atomically promotes the prepared staging directory to destination_root. Both
+// paths must remain on the same volume.
+bool CommitVastDataMigration(VastDataMigrationTransaction* transaction);
+
+// Moves any prepared or committed destination into the transaction directory
+// and records the rollback. The original Electron source remains untouched.
+bool RollbackVastDataMigration(VastDataMigrationTransaction* transaction);
+
+}  // namespace vast
