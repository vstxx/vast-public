+// Copyright 2026 The Vast Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_COLOR_VAST_COLOR_MIXER_H_
+#define CHROME_BROWSER_UI_COLOR_VAST_COLOR_MIXER_H_
+
+namespace ui {
+class ColorProvider;
+struct ColorProviderKey;
+}  // namespace ui
+
+// Adds the stable Vast shell palette to regular Chromium browser chrome.
+// User-installed themes are applied after this mixer.
+void AddVastColorMixer(ui::ColorProvider* provider,
+                       const ui::ColorProviderKey& key);
+
+#endif  // CHROME_BROWSER_UI_COLOR_VAST_COLOR_MIXER_H_
