--- /dev/null
+++ b/chrome/browser/ui/color/vast_color_mixer_unittest.cc
@@ -0,0 +1,44 @@
+// Copyright 2026 The Vast Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/color/vast_color_mixer.h"
+
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/color/color_id.h"
+#include "ui/color/color_mixer.h"
+#include "ui/color/color_provider.h"
+#include "ui/color/color_provider_key.h"
+#include "ui/color/color_recipe.h"
+
+TEST(VastColorMixerTest, AppliesVastShellPalette) {
+  ui::ColorProvider provider;
+  ui::ColorProviderKey key;
+
+  AddVastColorMixer(&provider, key);
+
+  EXPECT_EQ(SkColorSetRGB(0x07, 0x08, 0x0B),
+            provider.GetColor(ui::kColorFrameActive));
+  EXPECT_EQ(SkColorSetRGB(0x09, 0x0A, 0x0E),
+            provider.GetColor(kColorToolbar));
+  EXPECT_EQ(SkColorSetRGB(0x15, 0x19, 0x23),
+            provider.GetColor(kColorLocationBarBackground));
+  EXPECT_EQ(SkColorSetRGB(0x74, 0xE7, 0xFF),
+            provider.GetColor(kColorNewTabPageLink));
+  EXPECT_EQ(SkColorSetRGB(0xF3, 0xF5, 0xF8),
+            provider.GetColor(kColorTabForegroundActiveFrameActive));
+}
+
+TEST(VastColorMixerTest, PreservesHighContrastPalette) {
+  ui::ColorProvider provider;
+  ui::ColorMixer& base_mixer = provider.AddMixer();
+  base_mixer[kColorToolbar] = {SK_ColorRED};
+  ui::ColorProviderKey key;
+  key.contrast_mode = ui::ColorProviderKey::ContrastMode::kHigh;
+
+  AddVastColorMixer(&provider, key);
+
+  EXPECT_EQ(SK_ColorRED, provider.GetColor(kColorToolbar));
+}
