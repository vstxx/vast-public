+function titleCase(value: string, fallback: string): string {
+  const normalized = value.trim();
+  return normalized ?
+      normalized.charAt(0).toUpperCase() + normalized.slice(1) :
+      fallback;
+}
+
+function safeColor(value: string, fallback = '#74e7ff'): string {
+  return /^#[0-9a-f]{6}$/i.test(value) ? value : fallback;
+}
+
+function workspaceInitial(workspace: WorkspaceProjection): string {
+  const name = workspace.name.trim();
+  return name ? name.charAt(0).toLocaleUpperCase() : 'V';
+}
+
+function renderWorkspaceRail(workspaces: WorkspaceProjection[]) {
+  const list = getElement<HTMLDivElement>('workspace-list');
+  list.replaceChildren();
+
+  if (workspaces.length === 0) {
+    const placeholder = document.createElement('span');
+    placeholder.className = 'workspace-item active';
+    placeholder.dataset['workspaceId'] = 'fresh-profile';
+    placeholder.style.setProperty('--workspace-color', '#74e7ff');
+    placeholder.title = 'Fresh Vast profile';
+    placeholder.textContent = 'V';
+    list.appendChild(placeholder);
+    return;
+  }
+
+  const ordered = [...workspaces].sort((left, right) => left.order - right.order);
+  for (const workspace of ordered) {
+    const item = document.createElement('span');
+    item.className =
+        `workspace-item${workspace.active ? ' active' : ''}` +
+        `${workspace.isPrivate ? ' private' : ''}`;
+    item.dataset['workspaceId'] = workspace.id;
+    item.dataset['workspaceActive'] = String(workspace.active);
+    item.style.setProperty('--workspace-color', safeColor(workspace.color));
+    item.title = `${workspace.name}${workspace.isPrivate ? ' · private' : ''}`;
+    item.setAttribute('aria-label', item.title);
+    item.textContent = workspaceInitial(workspace);
+    list.appendChild(item);
+  }
+}
+
+function renderProductData(productData: ProductDataProjection) {
+  const workspaces = productData.selected && productData.compatible ?
+      productData.workspaces : [];
+  const settings = productData.settings;
+  const accent = safeColor(settings?.accentColor || '', '#74e7ff');
+  document.documentElement.style.setProperty('--vast-accent', accent);
+  document.documentElement.dataset['productTheme'] =
+      settings?.theme === 'light' ? 'light' : 'dark';
+
+  renderWorkspaceRail(workspaces);
+  setText('workspace-count', String(workspaces.length));
+
+  const activeWorkspace = workspaces.find(workspace => workspace.active) ||
+      workspaces[0];
+  setText('active-workspace-name', activeWorkspace?.name || 'Vast');
+
+  if (workspaces.length > 0) {
+    setText(
+        'workspace-summary',
+        `${workspaces.length} workspace${workspaces.length === 1 ? '' : 's'} ` +
+            'recovered from the selected Vast product-data root. Tabs, URLs, ' +
+            'history, notes, and secrets remain outside this UI boundary.');
+  } else {
+    setText(
+        'workspace-summary',
+        'Import a copied Vast data root to project your existing workspace ' +
+            'identity here. Your active Electron profile remains untouched.');
+  }
+
+  setText('theme-chip', `${titleCase(settings?.theme || '', 'Dark')} theme`);
+  setText(
+      'layout-chip',
+      `${titleCase(settings?.layoutMode || '', 'Horizontal')} layout`);
+  setText(
+      'session-chip',
+      settings?.restorePreviousSession ? 'Session restore on' :
+                                         'Session restore off');
+}
