diff --git a/chrome/browser/ui/color/vast_color_mixer.cc b/chrome/browser/ui/color/vast_color_mixer.cc
new file mode 100644
index 0000000000000000000000000000000000000000..799d762c95240539cb2156fdbd12dfa953b52ab9
--- /dev/null
+++ b/chrome/browser/ui/color/vast_color_mixer.cc
@@ -0,0 +1,93 @@
+// Copyright 2026 The Vast Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/color/vast_color_mixer.h"
+
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "build/build_config.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/color/color_id.h"
+#include "ui/color/color_mixer.h"
+#include "ui/color/color_provider.h"
+#include "ui/color/color_provider_key.h"
+#include "ui/color/color_recipe.h"
+
+namespace {
+
+constexpr SkColor kVastBackground = SkColorSetRGB(0x05, 0x05, 0x07);
+constexpr SkColor kVastFrame = SkColorSetRGB(0x07, 0x08, 0x0B);
+constexpr SkColor kVastFrameInactive = SkColorSetRGB(0x0C, 0x0D, 0x12);
+constexpr SkColor kVastToolbar = SkColorSetRGB(0x09, 0x0A, 0x0E);
+constexpr SkColor kVastSurface = SkColorSetRGB(0x15, 0x19, 0x23);
+constexpr SkColor kVastSurfaceHovered = SkColorSetRGB(0x20, 0x25, 0x31);
+constexpr SkColor kVastAccent = SkColorSetRGB(0x74, 0xE7, 0xFF);
+constexpr SkColor kVastText = SkColorSetRGB(0xF3, 0xF5, 0xF8);
+constexpr SkColor kVastMutedText = SkColorSetRGB(0x9A, 0xA0, 0xAD);
+constexpr SkColor kVastDivider = SkColorSetARGB(0x28, 0xFF, 0xFF, 0xFF);
+
+}  // namespace
+
+void AddVastColorMixer(ui::ColorProvider* provider,
+                       const ui::ColorProviderKey& key) {
+  // Forced colors must continue to be owned by the OS accessibility palette.
+  if (key.contrast_mode == ui::ColorProviderKey::ContrastMode::kHigh) {
+    return;
+  }
+
+  ui::ColorMixer& mixer = provider->AddMixer();
+
+  mixer[ui::kColorFrameActive] = {kVastFrame};
+  mixer[ui::kColorFrameInactive] = {kVastFrameInactive};
+  mixer[kColorToolbar] = {kVastToolbar};
+  mixer[kColorToolbarText] = {kVastText};
+  mixer[kColorToolbarButtonText] = {kVastText};
+  mixer[kColorToolbarButtonIcon] = {kVastText};
+  mixer[kColorToolbarButtonIconDefault] = {kVastText};
+  mixer[kColorToolbarButtonIconHovered] = {kVastAccent};
+  mixer[kColorToolbarButtonIconInactive] = {kVastMutedText};
+  mixer[kColorToolbarContentAreaSeparator] = {kVastDivider};
+  mixer[kColorToolbarSeparator] = {kVastDivider};
+  mixer[kColorToolbarTopSeparatorFrameActive] = {kVastDivider};
+  mixer[kColorToolbarTopSeparatorFrameInactive] = {kVastDivider};
+
+  mixer[kColorLocationBarBackground] = {kVastSurface};
+  mixer[kColorLocationBarBackgroundHovered] = {kVastSurfaceHovered};
+  mixer[kColorLocationBarBorder] = {kVastDivider};
+  mixer[kColorLocationBarBorderOpaque] = {kVastDivider};
+  mixer[kColorOmniboxText] = {kVastText};
+  mixer[kColorOmniboxTextDimmed] = {kVastMutedText};
+  mixer[kColorOmniboxResultsBackground] = {kVastToolbar};
+  mixer[kColorOmniboxResultsBackgroundHovered] = {kVastSurfaceHovered};
+  mixer[kColorOmniboxResultsBackgroundSelected] = {kVastSurfaceHovered};
+
+  mixer[kColorTabBackgroundActiveFrameActive] = {kVastToolbar};
+  mixer[kColorTabBackgroundActiveFrameInactive] = {kVastToolbar};
+  mixer[kColorTabBackgroundInactiveFrameActive] = {kVastFrame};
+  mixer[kColorTabBackgroundInactiveFrameInactive] = {kVastFrameInactive};
+  mixer[kColorTabForegroundActiveFrameActive] = {kVastText};
+  mixer[kColorTabForegroundActiveFrameInactive] = {kVastMutedText};
+  mixer[kColorTabForegroundInactiveFrameActive] = {kVastMutedText};
+  mixer[kColorTabForegroundInactiveFrameInactive] = {kVastMutedText};
+  mixer[kColorTabDividerFrameActive] = {kVastDivider};
+  mixer[kColorTabDividerFrameInactive] = {kVastDivider};
+  mixer[kColorNewTabButtonForegroundFrameActive] = {kVastText};
+  mixer[kColorNewTabButtonForegroundFrameInactive] = {kVastMutedText};
+  mixer[kColorNewTabButtonCRForegroundFrameActive] = {kVastText};
+  mixer[kColorNewTabButtonCRForegroundFrameInactive] = {kVastMutedText};
+  mixer[kColorNewTabButtonCRBackgroundFrameActive] = {kVastToolbar};
+  mixer[kColorNewTabButtonCRBackgroundFrameInactive] = {kVastFrameInactive};
+
+  mixer[kColorBookmarkBarBackground] = {kVastToolbar};
+  mixer[kColorBookmarkBarForeground] = {kVastText};
+  mixer[kColorBookmarkBarForegroundDisabled] = {kVastMutedText};
+  mixer[kColorBookmarkBarSeparator] = {kVastDivider};
+  mixer[kColorNewTabPageBackground] = {kVastBackground};
+  mixer[kColorNewTabPageText] = {kVastText};
+  mixer[kColorNewTabPageLink] = {kVastAccent};
+#if BUILDFLAG(IS_WIN)
+  mixer[kColorCaptionButtonOnToolbar] = {kVastText};
+  mixer[kColorCaptionForegroundActive] = {kVastText};
+  mixer[kColorCaptionForegroundInactive] = {kVastMutedText};
+#endif
+}
