{
  "manifest_version": 2,
  "name": "Adblocker for Vast",
  "version": "1.0.0",
  "description": "Block ads and trackers locally, with site controls, custom filters and cosmetic filtering.",
  "permissions": [
    "storage",
    "webRequest",
    "webRequestBlocking",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "dist/background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Adblocker for Vast",
    "default_popup": "popup.html",
    "default_icon": "assets/icon-128.png"
  },
  "options_page": "options.html",
  "icons": {
    "128": "assets/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "content_security_policy": "default-src 'self'; script-src 'self'; object-src 'none'; style-src 'self'; worker-src 'self'; connect-src 'self' https://easylist.to https://raw.githubusercontent.com https://secure.fanboy.co.nz; img-src 'self' data:; base-uri 'none'",
  "key": "",
  "vast_network": 1
}
